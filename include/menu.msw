/* menu.msw -- SWTOS menu shell */

DCL TITLE(20) CHAR INIT('SWTOS System Menu');
DCL OPT1(16) CHAR INIT('1: Hello');
DCL OPT2(16) CHAR INIT('2: Counter');
DCL OPT3(16) CHAR INIT('3: Uptime');
DCL OPT4(16) CHAR INIT('4: Clock');
DCL OPT_RUN(20) CHAR INIT('run <name>');
DCL OPT_LS(16) CHAR INIT('ls');
DCL PROMPT(9) CHAR INIT('Choice: ');
DCL BAD_MSG(16) CHAR INIT('Invalid choice');
DCL NOT_FOUND_MSG(20) CHAR INIT('Program not found');
DCL BANNER(40) CHAR INIT('==============================');
DCL RUN_NAME(17) CHAR;

GETCHAR: PROC(CH BYTE);
    ASM DO;
        'push    r0';
        'push    r1';
        'push    r2';
        '_getchar_rx_wait:';
        'la      r2,16711937';
        'lbu     r0,0(r2)';
        'lcu     r1,1';
        'and     r0,r1';
        'ceq     r0,z';
        'brt     _getchar_rx_wait';
        'la      r2,16711936';
        'lbu     r0,0(r2)';
        'lw      r2,9(fp)';
        'sb      r0,0(r2)';
        'pop     r2';
        'pop     r1';
        'pop     r0';
    END;
END;

MENU_DISCARD_LINE: PROC;
    DCL CH BYTE;
    DCL LINE_DONE INT;
    CH = 0;
    LINE_DONE = 0;
    DO WHILE (LINE_DONE = 0);
        CALL GETCHAR(ADDR(CH));
        IF (CH = 10) THEN LINE_DONE = 1;
        ELSE DO;
            IF (CH = 13) THEN LINE_DONE = 1;
        END;
    END;
END;

MENU_RUN_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    DCL POS INT;
    DCL LINE_DONE INT;
    VALID = 1;

    CALL GETCHAR(ADDR(CH));
    IF (CH = 117) THEN VALID = VALID;
    ELSE VALID = 0;
    CALL GETCHAR(ADDR(CH));
    IF (CH = 110) THEN VALID = VALID;
    ELSE VALID = 0;
    CALL GETCHAR(ADDR(CH));
    IF (CH = 32) THEN VALID = VALID;
    ELSE VALID = 0;

    IF (VALID = 0) THEN DO;
        CALL MENU_DISCARD_LINE;
        CALL UART_PUTS(ADDR(BAD_MSG));
    END;
    ELSE DO;
        POS = 0;
        LINE_DONE = 0;
        CALL GETCHAR(ADDR(CH));
        DO WHILE (LINE_DONE = 0);
            IF (CH = 10) THEN LINE_DONE = 1;
            ELSE DO;
                IF (CH = 13) THEN LINE_DONE = 1;
                ELSE DO;
                    IF (POS < 16) THEN DO;
                        RUN_NAME(POS) = CH;
                        POS = POS + 1;
                    END;
                    CALL GETCHAR(ADDR(CH));
                END;
            END;
        END;
        RUN_NAME(POS) = 0;
        CALL CATALOG_FIND_PROGRAM(ADDR(RUN_NAME));
        IF (CATALOG_FOUND = 1) THEN DO;
            CALL CATALOG_CALL_ENTRY(CATALOG_FOUND_ENTRY);
        END;
        ELSE DO;
            CALL UART_PUTS(ADDR(NOT_FOUND_MSG));
        END;
    END;
END;

MENU_LS_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL GETCHAR(ADDR(CH));
    IF (CH = 115) THEN VALID = VALID;
    ELSE VALID = 0;
    CALL GETCHAR(ADDR(CH));
    IF (CH = 10) THEN VALID = VALID;
    ELSE DO;
        IF (CH = 13) THEN VALID = VALID;
        ELSE DO;
            VALID = 0;
            CALL MENU_DISCARD_LINE;
        END;
    END;
    IF (VALID = 1) THEN DO;
        CALL CATALOG_LIST;
    END;
    ELSE DO;
        CALL UART_PUTS(ADDR(BAD_MSG));
    END;
END;

MENU: PROC;
    DCL CH BYTE;
    DCL DONE INT;
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL UART_PUTS(ADDR(BANNER));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(TITLE));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(BANNER));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT1));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT2));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT3));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT4));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT_RUN));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT_LS));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(PROMPT));
        CALL GETCHAR(ADDR(CH));
        CALL UART_PUTCHAR(10);
        IF (CH = 114) THEN DO;
            CALL MENU_RUN_COMMAND;
        END;
        ELSE DO;
        IF (CH = 108) THEN DO;
            CALL MENU_LS_COMMAND;
        END;
        ELSE DO;
        IF (CH = 49) THEN DO;
            CALL HELLO;
        END;
        ELSE DO;
            IF (CH = 50) THEN DO;
                CALL COUNTER;
            END;
            ELSE DO;
                IF (CH = 51) THEN DO;
                    CALL UPTIME;
                END;
                ELSE DO;
                IF (CH = 52) THEN DO;
                    CALL CLOCK;
                END;
                ELSE DO;
                    CALL UART_PUTS(ADDR(BAD_MSG));
                END;
            END;
        END;
        END;
        END;
        END;
        CALL UART_PUTCHAR(10);
    END;
END;
