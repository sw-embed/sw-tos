/* menu.msw -- SWTOS menu shell */

DCL TITLE(20) CHAR INIT('SWTOS System Menu');
DCL OPT1(16) CHAR INIT('1: Hello');
DCL OPT2(16) CHAR INIT('2: Counter');
DCL OPT0(16) CHAR INIT('0: Exit');
DCL PROMPT(8) CHAR INIT('Choice: ');
DCL BAD_MSG(16) CHAR INIT('Invalid choice');
DCL BANNER(40) CHAR INIT('==============================');

GETCHAR: PROC(CH BYTE);
    ASM DO;
        'push    r0';
        'push    r1';
        'push    r2';
        'la      r2,16711937';
        'lbu     r0,0(r2)';
        'lcu     r1,1';
        'and     r0,r1';
        'ceq     r0,z';
        'brt     -8';
        'la      r2,16711936';
        'lbu     r0,0(r2)';
        'lw      r2,12(fp)';
        'sb      r0,0(r2)';
        'pop     r2';
        'pop     r1';
        'pop     r0';
    END;
END;

MENU: PROC;
    DCL CH BYTE;
    DCL DONE INT;
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL UART_PUTS(ADDR(BANNER));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(TITLE));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(BANNER));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT1));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT2));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(OPT0));
        CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(PROMPT));
        CALL GETCHAR(CH);
        CALL UART_PUTCHAR(10);
        IF (CH = 49) THEN DO;
            CALL HELLO;
        END;
        ELSE DO;
            IF (CH = 50) THEN DO;
                CALL COUNTER;
            END;
            ELSE DO;
                IF (CH = 48) THEN DO;
                    DONE = 1;
                END;
                ELSE DO;
                    CALL UART_PUTS(ADDR(BAD_MSG));
                END;
            END;
        END;
        CALL UART_PUTCHAR(10);
    END;
END;
