/* clock_app.msw -- host-driven terminal uptime and local wall clock */

%DEFINE TIME_FRAME_UPTIME 1;
%DEFINE TIME_FRAME_CLOCK  2;

DCL UPTIME_TITLE(22) CHAR INIT('Terminal uptime log');
DCL CLOCK_TITLE(21) CHAR INIT('Host local wall clock');
DCL TIME_HINT(28) CHAR INIT('Ctrl-] returns to menu');
DCL TIME_PAYLOAD_BYTE BYTE;

TIME_GET_PAYLOAD: PROC;
    DCL CH BYTE;
    DCL CODE BYTE;
    CALL GETCHAR(ADDR(CH));
    IF (CH = 255) THEN DO;
        CALL GETCHAR(ADDR(CODE));
        IF (CODE = 0) THEN TIME_PAYLOAD_BYTE = 255;
        ELSE DO;
            IF (CODE = 3) THEN TIME_PAYLOAD_BYTE = 29;
            ELSE TIME_PAYLOAD_BYTE = CODE;
        END;
    END;
    ELSE TIME_PAYLOAD_BYTE = CH;
END;

TIME_PRINT_2: PROC(N INT);
    DCL Q INT;
    Q = N / 10;
    CALL UART_PUTCHAR(Q + 48);
    CALL UART_PUTCHAR(N - Q * 10 + 48);
END;

UPTIME_PRINT: PROC(TOTAL_SECONDS INT);
    DCL MINUTES INT;
    DCL SECONDS INT;
    DCL HUNDREDS INT;
    MINUTES = TOTAL_SECONDS / 60;
    HUNDREDS = MINUTES / 100;
    MINUTES = MINUTES - HUNDREDS * 100;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL TIME_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

CLOCK_PRINT: PROC(TOTAL_SECONDS INT);
    DCL HOURS INT;
    DCL MINUTES INT;
    DCL SECONDS INT;
    HOURS = TOTAL_SECONDS / 3600;
    MINUTES = (TOTAL_SECONDS - HOURS * 3600) / 60;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL TIME_PRINT_2(HOURS);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

TIME_APP: PROC(FRAME_CODE INT);
    DCL CH BYTE;
    DCL CODE BYTE;
    DCL B0 BYTE;
    DCL B1 BYTE;
    DCL B2 BYTE;
    DCL TICK INT;
    DCL CURRENT_SECOND INT;
    DCL LAST_SECOND INT;
    DCL SYNCED INT;
    DCL DONE INT;

    LAST_SECOND = 0;
    SYNCED = 0;
    DONE = 0;
    CALL UART_PUTS(ADDR(TIME_HINT));
    DO WHILE (DONE = 0);
        CALL GETCHAR(ADDR(CH));
        IF (CH = 27) THEN DONE = 1;
        ELSE DO;
            IF (CH = 255) THEN DO;
                CALL GETCHAR(ADDR(CODE));
                IF (CODE = FRAME_CODE) THEN DO;
                    CALL TIME_GET_PAYLOAD;
                    B0 = TIME_PAYLOAD_BYTE;
                    CALL TIME_GET_PAYLOAD;
                    B1 = TIME_PAYLOAD_BYTE;
                    CALL TIME_GET_PAYLOAD;
                    B2 = TIME_PAYLOAD_BYTE;
                    TICK = B0 + B1 * 256 + B2 * 65536;
                    CURRENT_SECOND = TICK / 100;
                    IF (SYNCED = 0) THEN DO;
                        LAST_SECOND = CURRENT_SECOND;
                        SYNCED = 1;
                        IF (FRAME_CODE = TIME_FRAME_UPTIME) THEN
                            CALL UPTIME_PRINT(CURRENT_SECOND);
                        ELSE CALL CLOCK_PRINT(CURRENT_SECOND);
                    END;
                    ELSE DO;
                        IF (CURRENT_SECOND = LAST_SECOND) THEN LAST_SECOND = LAST_SECOND;
                        ELSE DO;
                            LAST_SECOND = CURRENT_SECOND;
                            IF (FRAME_CODE = TIME_FRAME_UPTIME) THEN
                                CALL UPTIME_PRINT(CURRENT_SECOND);
                            ELSE CALL CLOCK_PRINT(CURRENT_SECOND);
                        END;
                    END;
                END;
            END;
        END;
    END;
END;

UPTIME: PROC;
    CALL UART_PUTS(ADDR(UPTIME_TITLE));
    CALL TIME_APP(TIME_FRAME_UPTIME);
END;

CLOCK: PROC;
    CALL UART_PUTS(ADDR(CLOCK_TITLE));
    CALL TIME_APP(TIME_FRAME_CLOCK);
END;
