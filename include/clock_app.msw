/* clock_app.msw -- heartbeat-driven uptime log */

DCL CLOCK_TITLE(20) CHAR INIT('Clock uptime log');
DCL CLOCK_HINT(28) CHAR INIT('Ctrl-] returns to menu');
DCL CLOCK_PAYLOAD_BYTE BYTE;

CLOCK_GET_PAYLOAD: PROC;
    DCL CH BYTE;
    DCL CODE BYTE;
    CALL GETCHAR(ADDR(CH));
    IF (CH = 255) THEN DO;
        CALL GETCHAR(ADDR(CODE));
        IF (CODE = 0) THEN DO;
            CLOCK_PAYLOAD_BYTE = 255;
        END;
        ELSE DO;
            IF (CODE = 3) THEN DO;
                CLOCK_PAYLOAD_BYTE = 29;
            END;
            ELSE DO;
                CLOCK_PAYLOAD_BYTE = CODE;
            END;
        END;
    END;
    ELSE DO;
        CLOCK_PAYLOAD_BYTE = CH;
    END;
END;

CLOCK_PRINT_2: PROC(N INT);
    DCL Q INT;
    Q = N / 10;
    CALL UART_PUTCHAR(Q + 48);
    CALL UART_PUTCHAR(N - Q * 10 + 48);
END;

CLOCK_PRINT_TIME: PROC(TOTAL_SECONDS INT);
    DCL MINUTES INT;
    DCL SECONDS INT;
    DCL HUNDREDS INT;
    MINUTES = TOTAL_SECONDS / 60;
    HUNDREDS = MINUTES / 100;
    MINUTES = MINUTES - HUNDREDS * 100;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL CLOCK_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL CLOCK_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

CLOCK: PROC;
    DCL CH BYTE;
    DCL CODE BYTE;
    DCL B0 BYTE;
    DCL B1 BYTE;
    DCL B2 BYTE;
    DCL TICK INT;
    DCL LAST_TICK INT;
    DCL TOTAL_TICKS INT;
    DCL CURRENT_SECOND INT;
    DCL LAST_SECOND INT;
    DCL SYNCED INT;
    DCL DONE INT;

    LAST_TICK = 0;
    TOTAL_TICKS = 0;
    LAST_SECOND = 0;
    SYNCED = 0;
    DONE = 0;
    CALL UART_PUTS(ADDR(CLOCK_TITLE));
    CALL UART_PUTS(ADDR(CLOCK_HINT));
    CALL CLOCK_PRINT_TIME(0);

    DO WHILE (DONE = 0);
        CALL GETCHAR(ADDR(CH));
        IF (CH = 27) THEN DO;
            DONE = 1;
        END;
        ELSE DO;
            IF (CH = 255) THEN DO;
                CALL GETCHAR(ADDR(CODE));
                IF (CODE = 1) THEN DO;
                    CALL CLOCK_GET_PAYLOAD;
                    B0 = CLOCK_PAYLOAD_BYTE;
                    CALL CLOCK_GET_PAYLOAD;
                    B1 = CLOCK_PAYLOAD_BYTE;
                    CALL CLOCK_GET_PAYLOAD;
                    B2 = CLOCK_PAYLOAD_BYTE;
                    TICK = B0 + B1 * 256 + B2 * 65536;
                    IF (SYNCED = 0) THEN DO;
                        LAST_TICK = TICK;
                        SYNCED = 1;
                    END;
                    ELSE DO;
                        TOTAL_TICKS = TOTAL_TICKS + TICK - LAST_TICK;
                        LAST_TICK = TICK;
                        CURRENT_SECOND = TOTAL_TICKS / 100;
                        IF (CURRENT_SECOND > LAST_SECOND) THEN DO;
                            LAST_SECOND = CURRENT_SECOND;
                            CALL CLOCK_PRINT_TIME(CURRENT_SECOND);
                        END;
                    END;
                END;
            END;
        END;
    END;
END;
