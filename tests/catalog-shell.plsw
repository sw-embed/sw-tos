SHELL_FILL_DEMO: PROC(STATE_PTR PTR);
    /* Spawn children until the process table refuses another, so the demo
       does not hard-code the slot count. Uptime and Clock alternate because
       both keep printing, which makes every pane visibly live; neither joins,
       so the shell stays usable while they run.

       Two cpu-hogs go in first, but only when a framed frontend is attached.
       They never yield, so the clocks that follow keep printing only if
       forced preemption is working, and forced preemption needs the heartbeat
       that only such a frontend sends. Under a bare UART the same two
       processes would take the CPU and never give it back, so there the table
       fills with clocks alone. The hogs are found by catalog name rather than
       held in the shell's private state, which keeps the spawn state the boot
       code fills unchanged. */
    DCL PRIVATE_STATE PTR;
    DCL SPAWN_STATUS INT;
    DCL WHICH INT;
    DCL HOG_DESC PTR;
    DCL FRAMED INT;
    PRIVATE_STATE = STATE_PTR;
    HOG_DESC = 0;
    FRAMED = 0;
    CALL TASK_FRONTEND_ATTACHED(ADDR(FRAMED));
    IF (FRAMED = 0) THEN HOG_DESC = 0;
    ELSE CALL TASK_CATALOG_FIND(ADDR(SHELL_CPU_HOG_NAME), ADDR(HOG_DESC));
    IF (HOG_DESC = 0) THEN HOG_DESC = 0;
    ELSE DO;
        SPAWN_STATUS = 0;
        CALL TASK_SPAWN(HOG_DESC);
        CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
        IF (SPAWN_STATUS = 0) THEN DO;
            CALL TASK_SPAWN(HOG_DESC);
            CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
        END;
    END;
    SPAWN_STATUS = 0;
    WHICH = 0;
    DO WHILE (SPAWN_STATUS = 0);
        IF (WHICH = 0) THEN DO;
            CALL TASK_SPAWN(PRIVATE_STATE->SPS_UPTIME_DESC);
            WHICH = 1;
        END;
        ELSE DO;
            CALL TASK_SPAWN(PRIVATE_STATE->SPS_CLOCK_DESC);
            WHICH = 0;
        END;
        CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    END;
    /* TASK_PROCESS_LIST, not SHELL_PS_COMMAND: the latter parses the typed
       line and would block here waiting for characters nobody will send. */
    CALL TASK_PROCESS_LIST;
    CALL SHELL_READY;
END;

SHELL_MULTITASK_DEMO: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL FIRST_STATUS INT;
    DCL SECOND_STATUS INT;
    DCL FIRST_EP INT;
    DCL SECOND_EP INT;
    PRIVATE_STATE = STATE_PTR;
    CALL TASK_SPAWN(PRIVATE_STATE->SPS_COUNTER_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(FIRST_STATUS));
    CALL TASK_SPAWN_ENDPOINT(ADDR(FIRST_EP));
    CALL TASK_SPAWN(PRIVATE_STATE->SPS_COUNTER_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(SECOND_STATUS));
    CALL TASK_SPAWN_ENDPOINT(ADDR(SECOND_EP));
    IF (FIRST_STATUS = 0) THEN DO;
        IF (SECOND_STATUS = 0) THEN DO;
            /* These two, not every process: the monitor is a child too. */
            CALL TASK_JOIN_ENDPOINT(FIRST_EP);
            CALL TASK_JOIN_ENDPOINT(SECOND_EP);
            CALL SHELL_READY;
        END;
        ELSE CALL SHELL_READY;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_READY: PROC;
    CALL UART_PUTCHAR(82);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(65);
    CALL UART_PUTCHAR(68);
    CALL UART_PUTCHAR(89);
    CALL UART_PUTCHAR(10);
END;

SHELL_RUN_SELECTED: PROC(DESC_PTR PTR);
    /* The menu runs its programs here, in the shell itself.

       It used to start one as a process and wait for it, which put its output
       in a pane of its own while the shell that was waiting for it owned
       another. Typing went to the shell, which was not reading, so a kill
       aimed at the pane that was scrolling did nothing at all -- and for a
       clock or an uptime, which never finish, the wait never ended.

       Run here there is one pane, one thing typing reaches, and Escape ends
       it, which is what a foreground program has always meant. Nothing is
       left in the process table to kill, because nothing was ever put there.
       Programs that should outlive the prompt are what bg is for. */
    CALL SHELL_SYNC_RUN(DESC_PTR);
END;

SHELL_SYNC_RUN: PROC(DESC_PTR PTR);
    /* Say how to get out before handing over. A program running here owns the
       shell until it ends, and one that ends on its own never needed telling
       -- but the ones that do not are exactly the ones nobody can guess at. */
    /* Run a program here, in the shell itself, with no process of its own.
       The prompt is gone until it finishes, so it had better finish; if it
       does not, the restart escape is the way back. */
    DCL SYNC_STATUS INT;
    CALL UART_PUTS(ADDR(SHELL_FG_HINT));
    CALL UART_PUTCHAR(10);
    CALL TASK_RUN_SYNC(DESC_PTR, ADDR(SYNC_STATUS));
    IF (SYNC_STATUS = 0) THEN CALL SHELL_READY;
    ELSE DO;
        CALL UART_PUTS(ADDR(SHELL_SYNC_NEEDS_SLOT));
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_RUN_SELECTED_NEW_TTY: PROC(DESC_PTR PTR);
    DCL SPAWN_STATUS INT;
    CALL TASK_SPAWN(DESC_PTR);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    /* A spawn hands input focus to the child. This one runs in the
       background, so the next thing typed belongs to the prompt. */
    CALL TASK_CLAIM_FOREGROUND;
    IF (SPAWN_STATUS = 0) THEN CALL SHELL_READY;
    ELSE DO;
        /* Status 2 is a full process table. Refusing was the honest answer
           when there was nowhere else to run it; there is now. */
        IF (SPAWN_STATUS = 2) THEN DO;
            CALL UART_PUTS(ADDR(SHELL_SYNC_NOTE));
            CALL UART_PUTCHAR(10);
            CALL SHELL_SYNC_RUN(DESC_PTR);
        END;
        ELSE DO;
            CALL UART_PUTCHAR(69);
            CALL UART_PUTCHAR(82);
            CALL UART_PUTCHAR(82);
            CALL UART_PUTCHAR(79);
            CALL UART_PUTCHAR(82);
            CALL UART_PUTCHAR(10);
        END;
    END;
END;

SHELL_LIST_COMMAND: PROC;
    CALL TASK_CATALOG_LIST;
END;

SHELL_PS_COMMAND: PROC(DETAILED INT);
    /* "ps" is the table: every slot, one word each, so it is plain which are
       free. "ps -l" is the detail, and detail about an empty slot is a row of
       zeroes under a name that is no longer there -- it reports what is
       running, which is what mon reports, from the same code. */
    IF (DETAILED = 0) THEN CALL TASK_PROCESS_LIST;
    ELSE CALL SHELL_REPORT;
END;

SHELL_SYNC_NAMED: PROC(NAME_PTR PTR);
    DCL DESC_PTR PTR;
    DESC_PTR = 0;
    CALL TASK_CATALOG_FIND(NAME_PTR, ADDR(DESC_PTR));
    IF (DESC_PTR = 0) THEN CALL SHELL_BAD;
    ELSE CALL SHELL_SYNC_RUN(DESC_PTR);
END;

SHELL_RUN_NAMED: PROC(NAME_PTR PTR);
    /* Start a catalog program by name, in a terminal of its own. The name
       arrives already read and already corrected: the line it came from was
       edited before anything looked at it. */
    DCL DESC_PTR PTR;
    DESC_PTR = 0;
    CALL TASK_CATALOG_FIND(NAME_PTR, ADDR(DESC_PTR));
    IF (DESC_PTR = 0) THEN CALL SHELL_BAD;
    ELSE CALL SHELL_RUN_SELECTED_NEW_TTY(DESC_PTR);
END;

SHELL_STARTUP_NOTHING: PROC;
    /* No program in this catalog asks to be started. */
    DCL IGNORED INT;
    IGNORED = 0;
END;

SHELL_START_ONCE: PROC(NAME_PTR PTR);
    /* Start a catalog program unless it is already running.
       Idempotent on purpose: this runs whenever a frontend attaches, and a
       reconnect must not stack a second copy on the first. */
    DCL DESC_PTR PTR;
    DCL EP INT;
    DCL RUNNING INT;
    DCL SPAWN_STATUS INT;
    DCL 1 PROC_INFO,
        3 SPI_STATE INT,
        3 SPI_BLOCKED INT,
        3 SPI_STACK_WORDS INT,
        3 SPI_STATE_WORDS INT,
        3 SPI_DISPATCH INT,
        3 SPI_YIELDS INT,
        3 SPI_IPC INT,
        3 SPI_TTY_IN INT,
        3 SPI_TTY_OUT INT,
        3 SPI_DESCRIPTOR PTR;
    DESC_PTR = 0;
    CALL TASK_CATALOG_FIND(NAME_PTR, ADDR(DESC_PTR));
    IF (DESC_PTR = 0) THEN DESC_PTR = 0;
    ELSE DO;
        RUNNING = 0;
        EP = 1;
        DO WHILE (EP < 17);
            CALL TASK_PROCESS_INFO(EP, ADDR(PROC_INFO));
            IF (PROC_INFO.SPI_STATE = 0) THEN EP = EP;
            ELSE DO;
                IF (PROC_INFO.SPI_DESCRIPTOR = DESC_PTR) THEN RUNNING = 1;
            END;
            EP = EP + 1;
        END;
        IF (RUNNING = 0) THEN DO;
            CALL TASK_SPAWN(DESC_PTR);
            CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
            /* A spawn hands input focus to the child. Nobody asked for this
               one, so the prompt keeps it. */
            CALL TASK_CLAIM_FOREGROUND;
        END;
    END;
END;

SHELL_KILL_COMMAND: PROC(ENDPOINT INT, DIGITS INT);
    /* End a process. The endpoint arrives parsed, so "kill ep=2" and "kill 2"
       are the same line by the time this sees it.

       BAD was the answer to every way this can fail, which left nothing to
       act on: a mistyped number, a process that had already gone and a
       process that was never there all read the same. */
    DCL STATUS INT;
    IF (DIGITS = 0) THEN DO;
        CALL UART_PUTS(ADDR(SHELL_KILL_USAGE));
        CALL UART_PUTCHAR(10);
    END;
    ELSE DO;
        CALL TASK_KILL(ENDPOINT, ADDR(STATUS));
        IF (STATUS = 0) THEN CALL SHELL_READY;
        ELSE DO;
            IF (STATUS = 2) THEN CALL UART_PUTS(ADDR(SHELL_KILL_GONE));
            ELSE CALL UART_PUTS(ADDR(SHELL_KILL_NO_SUCH));
            CALL UART_PUTCHAR(10);
        END;
    END;
END;

SHELL_REBOOT_COMMAND: PROC;
    /* This never returns. The HAL clears every child slot, allocator
       generation and virtual TTY, then rewinds endpoint 1. */
    CALL TASK_REBOOT;
END;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    /* Read a whole line, apply its corrections, then parse it.
       Nothing acts on a character as it arrives any more. Backspace removes
       the last character of the line wherever it is -- in the command, in its
       argument, across the space between them -- because the line is only
       looked at once it is finished. The old parser matched letters as they
       came and acted on a digit the instant it was pressed, so a mistake
       could not be taken back anywhere. */
    DCL PRIVATE_STATE PTR;
    DCL CH BYTE;
    DCL DONE INT;
    DCL READING INT;
    DCL CMD(65) CHAR;
    DCL CWORD(17) CHAR;
    DCL CARG(33) CHAR;
    DCL LLEN INT;
    DCL WLEN INT;
    DCL ALEN INT;
    DCL POS INT;
    DCL ANUM INT;
    DCL ADIGITS INT;
    DCL SCAN INT;
    DCL MATCHED INT;
    DCL OPT INT;
    PRIVATE_STATE = STATE_PTR;
    CALL SHELL_HELP_COMMAND(0, 0, 0);
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL SHELL_MENU;
        LLEN = 0;
        READING = 1;
        DO WHILE (READING = 1);
            CALL TASK_GETCHAR(ADDR(CH));
            IF (CH = 10) THEN READING = 0;
            ELSE DO;
            IF (CH = 13) THEN READING = 0;
            ELSE DO;
                IF (CH = 8) THEN DO;
                    IF (LLEN = 0) THEN LLEN = 0; ELSE LLEN = LLEN - 1;
                END;
                ELSE DO;
                IF (CH = 127) THEN DO;
                    IF (LLEN = 0) THEN LLEN = 0; ELSE LLEN = LLEN - 1;
                END;
                ELSE DO;
                    IF (LLEN < 64) THEN DO;
                        CMD(LLEN) = CH;
                        LLEN = LLEN + 1;
                    END;
                END;
                END;
            END;
            END;
        END;

        /* Split the corrected line into a command and its argument. */
        WLEN = 0;
        POS = 0;
        DO WHILE (POS < LLEN);
            IF (CMD(POS) = 32) THEN POS = LLEN;
            ELSE DO;
                IF (WLEN < 16) THEN DO;
                    CWORD(WLEN) = CMD(POS);
                    WLEN = WLEN + 1;
                END;
                POS = POS + 1;
            END;
        END;
        CWORD(WLEN) = 0;
        /* The second word only. Anything after it is ignored, which is how
           the retired --tty=new spelling still works. */
        ALEN = 0;
        POS = WLEN;
        SCAN = 1;
        DO WHILE (SCAN = 1);
            IF (POS = LLEN) THEN SCAN = 0;
            ELSE DO;
                IF (CMD(POS) = 32) THEN POS = POS + 1; ELSE SCAN = 0;
            END;
        END;
        DO WHILE (POS < LLEN);
            IF (CMD(POS) = 32) THEN POS = LLEN;
            ELSE DO;
                IF (ALEN < 32) THEN DO;
                    CARG(ALEN) = CMD(POS);
                    ALEN = ALEN + 1;
                END;
                POS = POS + 1;
            END;
        END;
        CARG(ALEN) = 0;

        /* Read the argument as a number when it is one, so "kill 2" and
           "kill ep=2" are the same request. */
        ANUM = 0;
        ADIGITS = 0;
        POS = 0;
        DO WHILE (POS < ALEN);
            IF (CARG(POS) < 48) THEN POS = POS;
            ELSE DO;
                IF (CARG(POS) < 58) THEN DO;
                    ANUM = ANUM * 10 + (CARG(POS) - 48);
                    ADIGITS = ADIGITS + 1;
                END;
            END;
            POS = POS + 1;
        END;

        /* -l, -r and -p are the only options any command takes. */
        OPT = 9;
        IF (ALEN = 0) THEN OPT = 0;
        IF (ALEN = 2) THEN DO;
            IF (CARG(0) = 45) THEN DO;
                IF (CARG(1) = 108) THEN OPT = 1;
                IF (CARG(1) = 114) THEN OPT = 2;
                IF (CARG(1) = 112) THEN OPT = 3;
            END;
        END;

        IF (WLEN = 0) THEN CALL SHELL_GENERATED_AUTOSTART;
        ELSE DO;
        IF (WLEN = 1) THEN DO;
            /* The numbered menu waits for its app: one thing at a time, in
               order, is what makes it a guided demo. run and bg never wait. */
            IF (CWORD(0) = 49) THEN CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_HELLO_DESC);
            ELSE DO;
            IF (CWORD(0) = 50) THEN CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_COUNTER_DESC);
            ELSE DO;
            IF (CWORD(0) = 51) THEN CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_UPTIME_DESC);
            ELSE DO;
            IF (CWORD(0) = 52) THEN CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_CLOCK_DESC);
            ELSE DO;
            IF (CWORD(0) = 53) THEN CALL SHELL_MULTITASK_DEMO(PRIVATE_STATE);
            ELSE DO;
            IF (CWORD(0) = 57) THEN CALL SHELL_FILL_DEMO(PRIVATE_STATE);
            ELSE CALL SHELL_BAD;
            END;
            END;
            END;
            END;
            END;
        END;
        ELSE DO;
            /* Match the whole word, not its first letter and its length:
               "mon" and "mem" are both m and three long, so mon ran the mem
               command. Anything that is not a command is taken as the name of
               a program to run, which is what a person means by typing it. */
            MATCHED = 0;
            IF (CWORD(0) = 104) THEN DO;
                IF (CWORD(1) = 101) THEN DO;
                    IF (WLEN = 4) THEN DO;
                        CALL SHELL_HELP_COMMAND(CARG(0), CARG(1), ALEN);
                        MATCHED = 1;
                    END;
                END;
            END;
            IF (CWORD(0) = 108) THEN DO;
                IF (CWORD(1) = 115) THEN DO;
                    IF (WLEN = 2) THEN DO; CALL SHELL_LIST_COMMAND; MATCHED = 1; END;
                END;
            END;
            IF (CWORD(0) = 100) THEN DO;
                IF (CWORD(1) = 105) THEN DO;
                    IF (WLEN = 3) THEN DO; CALL TASK_CATALOG_LIST; MATCHED = 1; END;
                END;
                IF (CWORD(1) = 102) THEN DO;
                    IF (WLEN = 2) THEN DO; CALL SHELL_GENERATED_DF; MATCHED = 1; END;
                END;
                IF (CWORD(1) = 117) THEN DO;
                    IF (WLEN = 2) THEN DO; CALL SHELL_GENERATED_DU; MATCHED = 1; END;
                END;
            END;
            IF (CWORD(0) = 112) THEN DO;
                IF (CWORD(1) = 115) THEN DO;
                    IF (WLEN = 2) THEN DO;
                        IF (OPT = 0) THEN DO; CALL SHELL_PS_COMMAND(0); MATCHED = 1; END;
                        IF (OPT = 1) THEN DO; CALL SHELL_PS_COMMAND(1); MATCHED = 1; END;
                    END;
                END;
            END;
            IF (CWORD(0) = 114) THEN DO;
                IF (CWORD(1) = 117) THEN DO;
                    IF (WLEN = 3) THEN DO;
                        IF (ALEN = 0) THEN CALL SHELL_BAD;
                        ELSE CALL SHELL_RUN_NAMED(ADDR(CARG));
                        MATCHED = 1;
                    END;
                END;
                IF (CWORD(1) = 101) THEN DO;
                    IF (WLEN = 6) THEN DO;
                        IF (ALEN = 0) THEN CALL SHELL_REBOOT_COMMAND;
                        ELSE CALL SHELL_BAD;
                        MATCHED = 1;
                    END;
                END;
            END;
            IF (CWORD(0) = 98) THEN DO;
                IF (CWORD(1) = 103) THEN DO;
                    IF (WLEN = 2) THEN DO;
                        IF (ALEN = 0) THEN CALL SHELL_BAD;
                        ELSE CALL SHELL_RUN_NAMED(ADDR(CARG));
                        MATCHED = 1;
                    END;
                END;
            END;
            IF (CWORD(0) = 115) THEN DO;
                IF (CWORD(1) = 121) THEN DO;
                    IF (WLEN = 4) THEN DO;
                        IF (ALEN = 0) THEN CALL SHELL_BAD;
                        ELSE CALL SHELL_SYNC_NAMED(ADDR(CARG));
                        MATCHED = 1;
                    END;
                END;
            END;
            IF (CWORD(0) = 107) THEN DO;
                IF (CWORD(1) = 105) THEN DO;
                    IF (WLEN = 4) THEN DO;
                        CALL SHELL_KILL_COMMAND(ANUM, ADIGITS);
                        MATCHED = 1;
                    END;
                END;
            END;
            IF (CWORD(0) = 109) THEN DO;
                IF (CWORD(1) = 101) THEN DO;
                    IF (WLEN = 3) THEN DO; CALL SHELL_MEM_COMMAND(OPT); MATCHED = 1; END;
                END;
            END;
            IF (CWORD(0) = 115) THEN DO;
                IF (CWORD(1) = 116) THEN DO;
                    IF (WLEN = 4) THEN DO;
                        CALL SHELL_STAT_COMMAND(ADDR(CARG), ALEN, ANUM, ADIGITS);
                        MATCHED = 1;
                    END;
                END;
            END;
            IF (CWORD(0) = 117) THEN DO;
                IF (CWORD(1) = 110) THEN DO;
                    IF (WLEN = 5) THEN DO; CALL SHELL_UNAME_COMMAND; MATCHED = 1; END;
                END;
            END;
            IF (MATCHED = 0) THEN CALL SHELL_RUN_NAMED(ADDR(CWORD));
        END;
        END;
    END;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->SPS_VALUE = PRIVATE_STATE->SPS_VALUE + 1;
        CALL TASK_STEP(PRIVATE_STATE->SPS_VALUE);
        IF (PRIVATE_STATE->SPS_VALUE = 2) THEN CALL TASK_EXIT;
    END;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    DCL CH BYTE;
    CALL UART_PUTCHAR(72);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(10);
    CALL UART_PUTCHAR(80);
    CALL UART_PUTCHAR(114);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(115);
    CALL UART_PUTCHAR(115);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(97);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(121);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(104);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(114);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(116);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(120);
    CALL UART_PUTCHAR(105);
    CALL UART_PUTCHAR(116);
    CALL UART_PUTCHAR(10);
    CALL TASK_GETCHAR(ADDR(CH));
    CALL TASK_EXIT;
END;

TIME_GET_PAYLOAD: PROC(OUT_PTR PTR);
    DCL CH BYTE;
    DCL CODE BYTE;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 255) THEN DO;
        CALL TASK_GETCHAR(ADDR(CODE));
        IF (CODE = 0) THEN OUT_PTR->CBR_VALUE = 255;
        ELSE DO;
            IF (CODE = 3) THEN OUT_PTR->CBR_VALUE = 29;
            ELSE OUT_PTR->CBR_VALUE = CODE;
        END;
    END;
    ELSE OUT_PTR->CBR_VALUE = CH;
END;

TIME_PRINT_2: PROC(N INT);
    DCL Q INT;
    Q = N / 10;
    CALL UART_PUTCHAR(Q + 48);
    CALL UART_PUTCHAR(N - Q * 10 + 48);
END;

UPTIME_PRINT: PROC(TOTAL_SECONDS INT);
    DCL MINUTES INT;
    DCL SECONDS INT;
    DCL HUNDREDS INT;
    MINUTES = TOTAL_SECONDS / 60;
    HUNDREDS = MINUTES / 100;
    MINUTES = MINUTES - HUNDREDS * 100;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL TIME_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

CLOCK_PRINT: PROC(TOTAL_SECONDS INT);
    DCL HOURS INT;
    DCL MINUTES INT;
    DCL SECONDS INT;
    HOURS = TOTAL_SECONDS / 3600;
    MINUTES = (TOTAL_SECONDS - HOURS * 3600) / 60;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL TIME_PRINT_2(HOURS);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

PLSW_TIME_APP: PROC(STATE_PTR PTR, FRAME_CODE INT);
    DCL CH BYTE;
    DCL CODE BYTE;
    DCL B0 BYTE;
    DCL B1 BYTE;
    DCL B2 BYTE;
    DCL TICK INT;
    DCL CURRENT_SECOND INT;
    DCL LAST_SECOND INT;
    DCL SYNCED INT;
    DCL DONE INT;
    LAST_SECOND = 0;
    SYNCED = 0;
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL TASK_GETCHAR(ADDR(CH));
        IF (CH = 27) THEN DONE = 1;
        ELSE DO;
            IF (CH = 255) THEN DO;
                CALL TASK_GETCHAR(ADDR(CODE));
                IF (CODE = FRAME_CODE) THEN DO;
                    CALL TIME_GET_PAYLOAD(ADDR(B0));
                    CALL TIME_GET_PAYLOAD(ADDR(B1));
                    CALL TIME_GET_PAYLOAD(ADDR(B2));
                    TICK = B0 + B1 * 256 + B2 * 65536;
                    IF (SYNCED = 0) THEN DO;
                        CURRENT_SECOND = TICK / 100;
                        LAST_SECOND = CURRENT_SECOND;
                        SYNCED = 1;
                        IF (FRAME_CODE = 1) THEN CALL UPTIME_PRINT(CURRENT_SECOND);
                        ELSE CALL CLOCK_PRINT(CURRENT_SECOND);
                    END;
                    ELSE DO;
                        CURRENT_SECOND = TICK / 100;
                        IF (CURRENT_SECOND = LAST_SECOND) THEN LAST_SECOND = LAST_SECOND;
                        ELSE DO;
                            LAST_SECOND = CURRENT_SECOND;
                            IF (FRAME_CODE = 1) THEN CALL UPTIME_PRINT(CURRENT_SECOND);
                            ELSE CALL CLOCK_PRINT(CURRENT_SECOND);
                        END;
                    END;
                END;
            END;
        END;
    END;
    CALL TASK_EXIT;
END;

SHELL_REPORT: PROC;
    /* The whole report, in the layout the frontend used to draw for itself:
       totals first, then one padded row per live process so the columns line
       up. There is one renderer now rather than two saying the same thing in
       different words.

       Free slots are skipped -- sixteen empty rows a second bury the
       processes that matter -- and the pane is cleared first so each report
       replaces the last instead of scrolling. */
    DCL EP INT;
    DCL PROGRAM PTR;
    DCL 1 PROC_INFO,
        3 SPI_STATE INT,
        3 SPI_BLOCKED INT,
        3 SPI_STACK_WORDS INT,
        3 SPI_STATE_WORDS INT,
        3 SPI_DISPATCH INT,
        3 SPI_YIELDS INT,
        3 SPI_IPC INT,
        3 SPI_TTY_IN INT,
        3 SPI_TTY_OUT INT,
        3 SPI_DESCRIPTOR PTR;
    DCL 1 HEAP_INFO,
        3 SHI_CURRENT INT,
        3 SHI_PEAK INT;
    DCL 1 PREEMPT_INFO,
        3 SPP_FORCED INT,
        3 SPP_CPU INT;
    DCL 1 MEMORY_INFO,
        3 SMI_TOTAL_WORDS INT,
        3 SMI_IMAGE_BYTES INT,
        3 SMI_ARENA_CURRENT_BYTES INT,
        3 SMI_ARENA_PEAK_BYTES INT,
        3 SMI_KERNEL_STACK_PEAK_BYTES INT,
        3 SMI_ALLOCATION_FAILURES INT,
        3 SMI_USED_SLOTS INT,
        3 SMI_TOTAL_SLOTS INT,
        3 SMI_ARENA_CAPACITY_BYTES INT;
    CALL TASK_MEM_INFO(ADDR(MEMORY_INFO));
    CALL TASK_HEAP_INFO(ADDR(HEAP_INFO));
    CALL UART_PUTS(ADDR(SHELL_MON_STK));
    CALL TASK_PRINT_UNSIGNED(MEMORY_INFO.SMI_ARENA_CURRENT_BYTES);
    CALL UART_PUTCHAR(47);
    CALL TASK_PRINT_UNSIGNED(MEMORY_INFO.SMI_ARENA_PEAK_BYTES);
    CALL UART_PUTS(ADDR(SHELL_MON_HEAP));
    CALL TASK_PRINT_UNSIGNED(HEAP_INFO.SHI_CURRENT);
    CALL UART_PUTCHAR(47);
    CALL TASK_PRINT_UNSIGNED(HEAP_INFO.SHI_PEAK);
    CALL UART_PUTS(ADDR(SHELL_MON_KSTK));
    CALL TASK_PRINT_UNSIGNED(MEMORY_INFO.SMI_KERNEL_STACK_PEAK_BYTES);
    CALL UART_PUTS(ADDR(SHELL_MON_FAIL));
    CALL TASK_PRINT_UNSIGNED(MEMORY_INFO.SMI_ALLOCATION_FAILURES);
    CALL UART_PUTS(ADDR(SHELL_MEM_SLOTS));
    CALL TASK_PRINT_UNSIGNED(MEMORY_INFO.SMI_USED_SLOTS);
    CALL UART_PUTCHAR(47);
    CALL TASK_PRINT_UNSIGNED(MEMORY_INFO.SMI_TOTAL_SLOTS);
    CALL UART_PUTCHAR(10);
    EP = 1;
    DO WHILE (EP < 17);
        CALL TASK_PROCESS_INFO(EP, ADDR(PROC_INFO));
        IF (PROC_INFO.SPI_STATE = 0) THEN EP = EP;
        ELSE DO;
            CALL TASK_PROCESS_PREEMPT_INFO(EP, ADDR(PREEMPT_INFO));
            PROGRAM = PROC_INFO.SPI_DESCRIPTOR;
            IF (PROGRAM = 0) THEN CALL TASK_PRINT_PADDED(ADDR(SHELL_PROC_NONE), 8);
            ELSE CALL TASK_PRINT_PADDED(PROGRAM->SPD_NAME, 8);
            CALL UART_PUTS(ADDR(SHELL_MON_EP));
            CALL TASK_PRINT_UNSIGNED(EP);
            CALL UART_PUTS(ADDR(SHELL_MON_STATE));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_STATE);
            CALL UART_PUTS(ADDR(SHELL_MON_BLOCKED));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_BLOCKED);
            CALL UART_PUTS(ADDR(SHELL_MON_ALLOC));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_STACK_WORDS);
            CALL UART_PUTCHAR(47);
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_STATE_WORDS);
            CALL UART_PUTS(ADDR(SHELL_MON_DISPATCH));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_DISPATCH);
            CALL UART_PUTS(ADDR(SHELL_MON_YIELDS));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_YIELDS);
            CALL UART_PUTS(ADDR(SHELL_PROC_FORCED));
            CALL TASK_PRINT_UNSIGNED(PREEMPT_INFO.SPP_FORCED);
            CALL UART_PUTS(ADDR(SHELL_PROC_CPU));
            CALL TASK_PRINT_UNSIGNED(PREEMPT_INFO.SPP_CPU);
            CALL UART_PUTS(ADDR(SHELL_PROC_IPC));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_IPC);
            CALL UART_PUTS(ADDR(SHELL_MON_IO));
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_TTY_IN);
            CALL UART_PUTCHAR(47);
            CALL TASK_PRINT_UNSIGNED(PROC_INFO.SPI_TTY_OUT);
            CALL UART_PUTCHAR(10);
        END;
        EP = EP + 1;
    END;
END;

MON_REPORT: PROC;
    /* Clear the pane, then report. ps -l asks for the same report without
       the clearing, so the two say the same thing by construction rather
       than by two renderers kept in step. */
    CALL UART_PUTCHAR(12);
    CALL SHELL_REPORT;
END;

PLSW_MON: PROC(STATE_PTR PTR);
    /* A resource monitor as an ordinary process: several may run at once and
       any of them can be killed, which the frontend's built-in Resources pane
       cannot be. It refreshes on the uptime tick rather than spinning, so it
       costs the scheduler nothing between reports, and Escape ends it like
       the other resident apps. */
    DCL CH BYTE;
    DCL CODE BYTE;
    DCL B0 BYTE;
    DCL B1 BYTE;
    DCL B2 BYTE;
    DCL DONE INT;
    CALL UART_PUTCHAR(109);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(110);
    CALL UART_PUTCHAR(10);
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL TASK_GETCHAR(ADDR(CH));
        IF (CH = 27) THEN DONE = 1;
        ELSE DO;
            IF (CH = 255) THEN DO;
                CALL TASK_GETCHAR(ADDR(CODE));
                IF (CODE = 1) THEN DO;
                    CALL TIME_GET_PAYLOAD(ADDR(B0));
                    CALL TIME_GET_PAYLOAD(ADDR(B1));
                    CALL TIME_GET_PAYLOAD(ADDR(B2));
                    CALL MON_REPORT;
                END;
            END;
        END;
    END;
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL UART_PUTCHAR(85);
    CALL UART_PUTCHAR(112);
    CALL UART_PUTCHAR(116);
    CALL UART_PUTCHAR(105);
    CALL UART_PUTCHAR(109);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(10);
    CALL PLSW_TIME_APP(STATE_PTR, 1);
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL UART_PUTCHAR(67);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(99);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(10);
    CALL PLSW_TIME_APP(STATE_PTR, 2);
END;
