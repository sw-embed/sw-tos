/* catalog-shell.plsw -- scheduled PL/SW run-command bridge */

%DEFINE LIBRARY;

DCL 1 SHELL_PROCESS_STATE BASED,
    3 SPS_UNUSED INT,
    3 SPS_COUNTER_DESC PTR;
PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL VALID INT;
    DCL CH BYTE;
    PRIVATE_STATE = STATE_PTR;
    CALL UART_PUTCHAR(83);
    CALL UART_PUTCHAR(72);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(76);
    CALL UART_PUTCHAR(76);
    CALL UART_PUTCHAR(10);
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 114) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 117) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 110) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 32) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 99) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 111) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 117) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 110) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 116) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 101) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 114) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 10) THEN VALID = VALID; ELSE VALID = 0;
    IF (VALID = 1) THEN DO;
        CALL TASK_SPAWN(PRIVATE_STATE->SPS_COUNTER_DESC);
        CALL TASK_YIELD;
        CALL TASK_YIELD;
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(83);
        CALL UART_PUTCHAR(85);
        CALL UART_PUTCHAR(77);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
    ELSE DO;
        CALL UART_PUTCHAR(66);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->SPS_UNUSED = PRIVATE_STATE->SPS_UNUSED + 1;
        CALL TASK_STEP(PRIVATE_STATE->SPS_UNUSED);
    END;
END;
