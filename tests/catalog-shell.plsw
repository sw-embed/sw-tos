DCL SHELL_TOPIC_BOOT(35) CHAR INIT('reboot ends apps and restarts shell');
DCL SHELL_PROC_FORCED(5) CHAR INIT(' fp=');
DCL SHELL_PROC_CPU(6) CHAR INIT(' cpu=');

SHELL_PRINT_INT: PROC(N INT);
    DCL D INT;
    DCL POS INT;
    DCL DIGITS(12) CHAR;
    IF (N = 0) THEN DO;
        CALL UART_PUTCHAR(48);
        RETURN;
    END;
    POS = 0;
    DO WHILE (N > 0);
        D = N / 10;
        DIGITS(POS) = N - D * 10 + 48;
        N = D;
        POS = POS + 1;
    END;
    DO WHILE (POS > 0);
        POS = POS - 1;
        CALL UART_PUTCHAR(DIGITS(POS));
    END;
END;

SHELL_BAD: PROC;
    CALL UART_PUTCHAR(66);
    CALL UART_PUTCHAR(65);
    CALL UART_PUTCHAR(68);
    CALL UART_PUTCHAR(10);
END;

SHELL_TOPIC_LINE: PROC(TEXT_PTR PTR);
    CALL UART_PUTS(TEXT_PTR);
    CALL UART_PUTCHAR(10);
END;

SHELL_HELP_COMMAND: PROC(A0 BYTE, A1 BYTE, ALEN INT);
    /* "help" lists the commands, "help NAME" explains one. Matching on the
       first two characters and the length tells these apart and costs no
       storage. The tests are written flat rather than as one long else
       chain, which the compiler will not nest this deep. */
    DCL FOUND INT;
    IF (ALEN = 0) THEN DO;
        CALL UART_PUTS(ADDR(SHELL_HELP_1)); CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(SHELL_HELP_2)); CALL UART_PUTCHAR(10);
    END;
    ELSE DO;
        FOUND = 0;
        IF (A0 = 104) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_HELP)); FOUND = 1; END;
        IF (A0 = 108) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_LS)); FOUND = 1; END;
        IF (A0 = 112) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_PS)); FOUND = 1; END;
        IF (A0 = 114) THEN DO;
            IF (A1 = 117) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_RUN)); FOUND = 1; END;
        END;
        IF (A0 = 98) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_BG)); FOUND = 1; END;
        IF (A0 = 107) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_KILL)); FOUND = 1; END;
        IF (A0 = 109) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_MEM)); FOUND = 1; END;
        IF (A0 = 115) THEN DO;
            IF (A1 = 116) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_STAT)); FOUND = 1; END;
            IF (A1 = 121) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_SYNC)); FOUND = 1; END;
        END;
        IF (A0 = 117) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_UNAME)); FOUND = 1; END;
        IF (A0 = 114) THEN DO;
            IF (A1 = 101) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_BOOT)); FOUND = 1; END;
        END;
        IF (A0 = 100) THEN DO;
            IF (A1 = 105) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_LS)); FOUND = 1; END;
            IF (A1 = 102) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_DF)); FOUND = 1; END;
            IF (A1 = 117) THEN DO; CALL SHELL_TOPIC_LINE(ADDR(SHELL_TOPIC_DU)); FOUND = 1; END;
        END;
        IF (FOUND = 0) THEN CALL SHELL_BAD;
    END;
END;

SHELL_UNAME_COMMAND: PROC;
    CALL UART_PUTS(ADDR(SHELL_UNAME_TEXT));
    CALL UART_PUTCHAR(10);
END;

SHELL_MEM_SUMMARY: PROC;
    DCL 1 MEMORY_INFO,
        3 SMI_TOTAL_WORDS INT,
        3 SMI_IMAGE_BYTES INT,
        3 SMI_ARENA_CURRENT_BYTES INT,
        3 SMI_ARENA_PEAK_BYTES INT,
        3 SMI_KERNEL_STACK_PEAK_BYTES INT,
        3 SMI_ALLOCATION_FAILURES INT,
        3 SMI_USED_SLOTS INT,
        3 SMI_TOTAL_SLOTS INT,
        3 SMI_ARENA_CAPACITY_BYTES INT;
    DCL IMAGE_WORDS INT;
    DCL ARENA_WORDS INT;
    DCL ARENA_PEAK_WORDS INT;
    DCL KSTACK_WORDS INT;
    DCL FREE_WORDS INT;
    CALL TASK_MEM_INFO(ADDR(MEMORY_INFO));
    IMAGE_WORDS = MEMORY_INFO.SMI_IMAGE_BYTES / 3;
    ARENA_WORDS = MEMORY_INFO.SMI_ARENA_CURRENT_BYTES / 3;
    ARENA_PEAK_WORDS = MEMORY_INFO.SMI_ARENA_PEAK_BYTES / 3;
    KSTACK_WORDS = MEMORY_INFO.SMI_KERNEL_STACK_PEAK_BYTES / 3;
    FREE_WORDS = MEMORY_INFO.SMI_TOTAL_WORDS - IMAGE_WORDS;
    FREE_WORDS = FREE_WORDS - ARENA_WORDS - KSTACK_WORDS;
    CALL UART_PUTS(ADDR(SHELL_MEM_TOTAL)); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_TOTAL_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_IMAGE)); CALL SHELL_PRINT_INT(IMAGE_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_ARENA)); CALL SHELL_PRINT_INT(ARENA_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_PEAK)); CALL SHELL_PRINT_INT(ARENA_PEAK_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_KSTACK)); CALL SHELL_PRINT_INT(KSTACK_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_FREE)); CALL SHELL_PRINT_INT(FREE_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_FAIL)); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_ALLOCATION_FAILURES);
    CALL UART_PUTS(ADDR(SHELL_MEM_SLOTS)); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_USED_SLOTS);
    CALL UART_PUTCHAR(47); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_TOTAL_SLOTS);
    CALL UART_PUTCHAR(10);
END;

SHELL_MEM_IMAGE_FIELD: PROC(WORDS INT, BASE PTR);
    /* A resident program runs from the linked image, which every process
       shares, so there is no private extent to report for one. */
    CALL UART_PUTS(ADDR(SHELL_MEM_IMAGE));
    IF (WORDS = 0) THEN CALL UART_PUTS(ADDR(SHELL_MEM_NONE));
    ELSE CALL SHELL_MEM_IMAGE_EXTENT(WORDS, BASE);
END;

SHELL_MEM_IMAGE_EXTENT: PROC(WORDS INT, BASE PTR);
    CALL SHELL_PRINT_INT(WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_AT));
    CALL TASK_PRINT_HEX(BASE);
END;

SHELL_MEM_PROCESS_LINE: PROC(ENDPOINT INT);
    DCL 1 PROCESS_MEMORY_INFO,
        3 SPM_STATUS INT,
        3 SPM_STACK_WORDS INT,
        3 SPM_STATE_WORDS INT,
        3 SPM_TOTAL_WORDS INT,
        3 SPM_STACK_TOP PTR,
        3 SPM_STATE_PTR PTR,
        3 SPM_IMAGE_BASE PTR,
        3 SPM_IMAGE_WORDS INT;
    DCL STACK_BASE INT;
    CALL TASK_MEM_PROCESS_INFO(ENDPOINT, ADDR(PROCESS_MEMORY_INFO));
    /* A free slot owns nothing, and sixteen rows of zeroes are what ps is
       for. Report the ones that are using memory. */
    IF (PROCESS_MEMORY_INFO.SPM_STATUS = 0) THEN ENDPOINT = ENDPOINT;
    ELSE DO;
        CALL UART_PUTS(ADDR(SHELL_MEM_EP)); CALL SHELL_PRINT_INT(ENDPOINT);
        CALL UART_PUTS(ADDR(SHELL_MEM_STATUS)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_STATUS);
        /* Each region as words@address. The stack address is the low end of
           the allocation, which is where it starts: a stack grows down from
           its high end, so reporting that end said where it finishes. */
        STACK_BASE = PROCESS_MEMORY_INFO.SPM_STACK_TOP;
        STACK_BASE = STACK_BASE - PROCESS_MEMORY_INFO.SPM_STACK_WORDS * 3;
        CALL UART_PUTS(ADDR(SHELL_MEM_PROC_STACK)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_STACK_WORDS);
        CALL UART_PUTS(ADDR(SHELL_MEM_AT)); CALL TASK_PRINT_HEX(STACK_BASE);
        CALL UART_PUTS(ADDR(SHELL_MEM_PROC_STATE)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_STATE_WORDS);
        CALL UART_PUTS(ADDR(SHELL_MEM_AT)); CALL TASK_PRINT_HEX(PROCESS_MEMORY_INFO.SPM_STATE_PTR);
        CALL SHELL_MEM_IMAGE_FIELD(PROCESS_MEMORY_INFO.SPM_IMAGE_WORDS, PROCESS_MEMORY_INFO.SPM_IMAGE_BASE);
        CALL UART_PUTS(ADDR(SHELL_MEM_PROC_TOTAL)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_TOTAL_WORDS);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_MEM_PROCESS_ALL: PROC;
    DCL EP INT;
    EP = 1;
    DO WHILE (EP < 17);
        CALL SHELL_MEM_PROCESS_LINE(EP);
        EP = EP + 1;
    END;
END;

SHELL_MEM_COMMAND: PROC(OPTION INT);
    /* 0 summary, 2 reset, 3 per process. Anything else was not a mem option. */
    IF (OPTION = 0) THEN CALL SHELL_MEM_SUMMARY;
    ELSE DO;
    IF (OPTION = 3) THEN CALL SHELL_MEM_PROCESS_ALL;
    ELSE DO;
    IF (OPTION = 2) THEN DO;
        CALL TASK_MEM_RESET;
        CALL UART_PUTS(ADDR(SHELL_MEM_RESET_TEXT));
        CALL UART_PUTCHAR(10);
    END;
    ELSE CALL SHELL_BAD;
    END;
    END;
END;

SHELL_STAT_COMMAND: PROC(NAME_PTR PTR, ALEN INT, ANUM INT, ADIGITS INT);
    /* A name, or a single-digit endpoint. Both arrive read and corrected. */
    DCL VALID INT;
    DCL IMAGE_BYTES INT;
    DCL DESC_PTR PTR;
    DCL ENDPOINT INT;
    VALID = 1;
    IF (ALEN = 0) THEN VALID = 0;
    ENDPOINT = 0;
    IF (ADIGITS = 1) THEN DO;
        IF (ANUM > 0) THEN DO;
            IF (ANUM < 4) THEN ENDPOINT = ANUM;
        END;
    END;
    DESC_PTR = 0;
    IF (ENDPOINT > 0) THEN CALL SHELL_PROCESS_LINE(ENDPOINT);
    ELSE DO;
      IF (VALID = 1) THEN CALL TASK_CATALOG_STAT_FIND(NAME_PTR, ADDR(DESC_PTR));
      IF (DESC_PTR = 0) THEN CALL SHELL_BAD;
      ELSE DO;
        CALL UART_PUTS(DESC_PTR->SPD_NAME);
        CALL UART_PUTS(ADDR(SHELL_STAT_KIND));
        IF (DESC_PTR->SPD_KIND = 2) THEN CALL UART_PUTS(ADDR(SHELL_SERVICE_TEXT));
        ELSE CALL UART_PUTS(ADDR(SHELL_PROGRAM_TEXT));
        CALL UART_PUTS(ADDR(SHELL_STAT_SOURCE));
        IF (DESC_PTR->SPD_KIND = 1) THEN CALL UART_PUTS(ADDR(SHELL_EMBEDDED_TEXT));
        ELSE CALL UART_PUTS(ADDR(SHELL_RESIDENT_TEXT));
        CALL UART_PUTS(ADDR(SHELL_STAT_STACK)); CALL SHELL_PRINT_INT(DESC_PTR->SPD_STACK_WORDS);
        CALL UART_PUTS(ADDR(SHELL_STAT_STATE)); CALL SHELL_PRINT_INT(DESC_PTR->SPD_STATE_WORDS);
        CALL UART_PUTS(ADDR(SHELL_STAT_FLAGS)); CALL SHELL_PRINT_INT(DESC_PTR->SPD_FLAGS);
        IMAGE_BYTES = DESC_PTR->SPD_IMAGE_WORDS;
        IMAGE_BYTES = IMAGE_BYTES * 3;
        CALL UART_PUTS(ADDR(SHELL_STAT_IMAGE)); CALL SHELL_PRINT_INT(IMAGE_BYTES);
        CALL UART_PUTCHAR(10);
      END;
    END;
END;

SHELL_PROCESS_LINE: PROC(ENDPOINT INT);
    CALL TASK_PROCESS_PRINT(ENDPOINT);
END;

