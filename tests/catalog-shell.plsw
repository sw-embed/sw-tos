DCL SHELL_TOPIC_PS(36) CHAR INIT('ps lists processes, ps -l in detail');
DCL SHELL_TOPIC_RUN(42) CHAR INIT('run NAME starts a program in its own pane');
DCL SHELL_TOPIC_BG(42) CHAR INIT('bg NAME is run, and the prompt stays free');
DCL SHELL_TOPIC_KILL(42) CHAR INIT('kill EP ends a process, ep=N accepted too');
DCL SHELL_TOPIC_MEM(46) CHAR INIT('mem totals, mem -r resets, mem -p per process');
DCL SHELL_TOPIC_STAT(35) CHAR INIT('stat NAME or stat EP describes one');
