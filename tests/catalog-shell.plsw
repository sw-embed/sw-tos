/* catalog-shell.plsw -- persistent scheduled PL/SW menu bridge */

%DEFINE LIBRARY;

DCL 1 SHELL_PROCESS_STATE BASED,
    3 SPS_VALUE INT,
    3 SPS_COUNTER_DESC PTR,
    3 SPS_HELLO_DESC PTR,
    3 SPS_CLOCK_DESC PTR,
    3 SPS_EMBEDDED_DESC PTR,
    3 SPS_UPTIME_DESC PTR;
DCL 1 CLOCK_BYTE_REF BASED,
    3 CBR_VALUE BYTE;
DCL 1 SHELL_PROGRAM_DESC BASED,
    3 SPD_NAME PTR,
    3 SPD_KIND INT,
    3 SPD_SCHEDULED_ENTRY PTR,
    3 SPD_IMAGE PTR,
    3 SPD_IMAGE_WORDS INT,
    3 SPD_STACK_WORDS INT,
    3 SPD_STATE_WORDS INT,
    3 SPD_FLAGS INT;
DCL SHELL_HELP_1(21) CHAR INIT('help ls dir ps run');
DCL SHELL_HELP_2(24) CHAR INIT('df du mem stat uname');
DCL SHELL_UNAME_TEXT(17) CHAR INIT('SWTOS COR24 0.1');
DCL SHELL_CPU_HOG_NAME(8) CHAR INIT('cpu-hog');
DCL SHELL_STAT_KIND(7) CHAR INIT(' kind=');
DCL SHELL_STAT_SOURCE(9) CHAR INIT(' source=');
DCL SHELL_STAT_STACK(8) CHAR INIT(' stack=');
DCL SHELL_STAT_STATE(8) CHAR INIT(' state=');
DCL SHELL_STAT_FLAGS(8) CHAR INIT(' flags=');
DCL SHELL_STAT_IMAGE(8) CHAR INIT(' image=');
DCL SHELL_PROGRAM_TEXT(8) CHAR INIT('program');
DCL SHELL_SERVICE_TEXT(8) CHAR INIT('service');
DCL SHELL_RESIDENT_TEXT(9) CHAR INIT('resident');
DCL SHELL_EMBEDDED_TEXT(9) CHAR INIT('embedded');
DCL SHELL_MEM_TOTAL(8) CHAR INIT('total=');
DCL SHELL_MEM_IMAGE(8) CHAR INIT(' image=');
DCL SHELL_MEM_ARENA(8) CHAR INIT(' arena=');
DCL SHELL_MEM_PEAK(7) CHAR INIT(' peak=');
DCL SHELL_MEM_KSTACK(9) CHAR INIT(' kstack=');
DCL SHELL_MEM_FREE(7) CHAR INIT(' free=');
DCL SHELL_MEM_FAIL(11) CHAR INIT(' failures=');
DCL SHELL_MEM_SLOTS(8) CHAR INIT(' slots=');
DCL SHELL_MEM_RESET_TEXT(16) CHAR INIT('mem counters reset');
DCL SHELL_MEM_EP(5) CHAR INIT('ep=');
DCL SHELL_MEM_STATUS(9) CHAR INIT(' status=');
DCL SHELL_MEM_PROC_STACK(8) CHAR INIT(' stack=');
DCL SHELL_MEM_PROC_STATE(8) CHAR INIT(' state=');
DCL SHELL_MEM_PROC_TOTAL(8) CHAR INIT(' total=');
DCL SHELL_PROC_EP(4) CHAR INIT('ep=');
DCL SHELL_PROC_NAME(7) CHAR INIT(' name=');
DCL SHELL_PROC_STATUS(8) CHAR INIT(' state=');
DCL SHELL_PROC_BLOCKED(10) CHAR INIT(' blocked=');
DCL SHELL_PROC_STACK(8) CHAR INIT(' stack=');
DCL SHELL_PROC_STATE_WORDS(8) CHAR INIT(' statew=');
DCL SHELL_PROC_DISPATCH(11) CHAR INIT(' dispatch=');
DCL SHELL_PROC_YIELDS(8) CHAR INIT(' yields=');
DCL SHELL_PROC_IPC(6) CHAR INIT(' ipc=');
DCL SHELL_PROC_TTY_IN(9) CHAR INIT(' ttyin=');
DCL SHELL_PROC_TTY_OUT(10) CHAR INIT(' ttyout=');
DCL SHELL_PROC_NONE(5) CHAR INIT('none');

SHELL_PRINT_INT: PROC(N INT);
    DCL D INT;
    DCL POS INT;
    DCL DIGITS(12) CHAR;
    IF (N = 0) THEN DO;
        CALL UART_PUTCHAR(48);
        RETURN;
    END;
    POS = 0;
    DO WHILE (N > 0);
        D = N / 10;
        DIGITS(POS) = N - D * 10 + 48;
        N = D;
        POS = POS + 1;
    END;
    DO WHILE (POS > 0);
        POS = POS - 1;
        CALL UART_PUTCHAR(DIGITS(POS));
    END;
END;

SHELL_BAD: PROC;
    CALL UART_PUTCHAR(66);
    CALL UART_PUTCHAR(65);
    CALL UART_PUTCHAR(68);
    CALL UART_PUTCHAR(10);
END;

SHELL_HELP_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 101) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 108) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 112) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 10) THEN VALID = VALID; ELSE VALID = 0;
    IF (VALID = 1) THEN DO;
        CALL UART_PUTS(ADDR(SHELL_HELP_1)); CALL UART_PUTCHAR(10);
        CALL UART_PUTS(ADDR(SHELL_HELP_2)); CALL UART_PUTCHAR(10);
    END;
    ELSE CALL SHELL_BAD;
END;

SHELL_UNAME_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 110) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 97) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 109) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 101) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 10) THEN VALID = VALID; ELSE VALID = 0;
    IF (VALID = 1) THEN DO; CALL UART_PUTS(ADDR(SHELL_UNAME_TEXT)); CALL UART_PUTCHAR(10); END;
    ELSE CALL SHELL_BAD;
END;

SHELL_D_COMMAND: PROC;
    DCL CH BYTE;
    DCL NEXT BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 102) THEN DO;
        CALL TASK_GETCHAR(ADDR(NEXT));
        IF (NEXT = 10) THEN CALL SHELL_GENERATED_DF; ELSE CALL SHELL_BAD;
    END;
    ELSE DO;
        IF (CH = 117) THEN DO;
            CALL TASK_GETCHAR(ADDR(NEXT));
            IF (NEXT = 10) THEN CALL SHELL_GENERATED_DU; ELSE CALL SHELL_BAD;
        END;
        ELSE DO;
            IF (CH = 105) THEN DO;
                CALL TASK_GETCHAR(ADDR(NEXT)); IF (NEXT = 114) THEN VALID = VALID; ELSE VALID = 0;
                CALL TASK_GETCHAR(ADDR(NEXT)); IF (NEXT = 10) THEN VALID = VALID; ELSE VALID = 0;
                IF (VALID = 1) THEN CALL TASK_CATALOG_LIST; ELSE CALL SHELL_BAD;
            END;
            ELSE CALL SHELL_BAD;
        END;
    END;
END;

SHELL_MEM_SUMMARY: PROC;
    DCL 1 MEMORY_INFO,
        3 SMI_TOTAL_WORDS INT,
        3 SMI_IMAGE_BYTES INT,
        3 SMI_ARENA_CURRENT_BYTES INT,
        3 SMI_ARENA_PEAK_BYTES INT,
        3 SMI_KERNEL_STACK_PEAK_BYTES INT,
        3 SMI_ALLOCATION_FAILURES INT,
        3 SMI_USED_SLOTS INT,
        3 SMI_TOTAL_SLOTS INT,
        3 SMI_ARENA_CAPACITY_BYTES INT;
    DCL IMAGE_WORDS INT;
    DCL ARENA_WORDS INT;
    DCL ARENA_PEAK_WORDS INT;
    DCL KSTACK_WORDS INT;
    DCL FREE_WORDS INT;
    CALL TASK_MEM_INFO(ADDR(MEMORY_INFO));
    IMAGE_WORDS = MEMORY_INFO.SMI_IMAGE_BYTES / 3;
    ARENA_WORDS = MEMORY_INFO.SMI_ARENA_CURRENT_BYTES / 3;
    ARENA_PEAK_WORDS = MEMORY_INFO.SMI_ARENA_PEAK_BYTES / 3;
    KSTACK_WORDS = MEMORY_INFO.SMI_KERNEL_STACK_PEAK_BYTES / 3;
    FREE_WORDS = MEMORY_INFO.SMI_TOTAL_WORDS - IMAGE_WORDS;
    FREE_WORDS = FREE_WORDS - ARENA_WORDS - KSTACK_WORDS;
    CALL UART_PUTS(ADDR(SHELL_MEM_TOTAL)); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_TOTAL_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_IMAGE)); CALL SHELL_PRINT_INT(IMAGE_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_ARENA)); CALL SHELL_PRINT_INT(ARENA_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_PEAK)); CALL SHELL_PRINT_INT(ARENA_PEAK_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_KSTACK)); CALL SHELL_PRINT_INT(KSTACK_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_FREE)); CALL SHELL_PRINT_INT(FREE_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_FAIL)); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_ALLOCATION_FAILURES);
    CALL UART_PUTS(ADDR(SHELL_MEM_SLOTS)); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_USED_SLOTS);
    CALL UART_PUTCHAR(47); CALL SHELL_PRINT_INT(MEMORY_INFO.SMI_TOTAL_SLOTS);
    CALL UART_PUTCHAR(10);
END;

SHELL_MEM_PROCESS_LINE: PROC(ENDPOINT INT);
    DCL 1 PROCESS_MEMORY_INFO,
        3 SPM_STATUS INT,
        3 SPM_STACK_WORDS INT,
        3 SPM_STATE_WORDS INT,
        3 SPM_TOTAL_WORDS INT;
    CALL TASK_MEM_PROCESS_INFO(ENDPOINT, ADDR(PROCESS_MEMORY_INFO));
    CALL UART_PUTS(ADDR(SHELL_MEM_EP)); CALL SHELL_PRINT_INT(ENDPOINT);
    CALL UART_PUTS(ADDR(SHELL_MEM_STATUS)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_STATUS);
    CALL UART_PUTS(ADDR(SHELL_MEM_PROC_STACK)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_STACK_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_PROC_STATE)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_STATE_WORDS);
    CALL UART_PUTS(ADDR(SHELL_MEM_PROC_TOTAL)); CALL SHELL_PRINT_INT(PROCESS_MEMORY_INFO.SPM_TOTAL_WORDS);
    CALL UART_PUTCHAR(10);
END;

SHELL_MEM_COMMAND: PROC;
    DCL CH BYTE;
    DCL NEXT BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 101) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 109) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (VALID = 0) THEN CALL SHELL_BAD;
    ELSE DO;
        IF (CH = 10) THEN CALL SHELL_MEM_SUMMARY;
        ELSE DO;
            IF (CH = 32) THEN DO;
                CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 45) THEN VALID = VALID; ELSE VALID = 0;
                CALL TASK_GETCHAR(ADDR(CH));
                IF (CH = 112) THEN DO;
                    CALL TASK_GETCHAR(ADDR(NEXT));
                    IF (NEXT = 10) THEN DO;
                        CALL SHELL_MEM_PROCESS_LINE(1);
                        CALL SHELL_MEM_PROCESS_LINE(2);
                        CALL SHELL_MEM_PROCESS_LINE(3);
                    END;
                    ELSE CALL SHELL_BAD;
                END;
                ELSE DO;
                    IF (CH = 114) THEN DO;
                        CALL TASK_GETCHAR(ADDR(NEXT));
                        IF (NEXT = 10) THEN DO;
                            CALL TASK_MEM_RESET;
                            CALL UART_PUTS(ADDR(SHELL_MEM_RESET_TEXT)); CALL UART_PUTCHAR(10);
                        END;
                        ELSE CALL SHELL_BAD;
                    END;
                    ELSE CALL SHELL_BAD;
                END;
            END;
            ELSE CALL SHELL_BAD;
        END;
    END;
END;

SHELL_STAT_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    DCL POS INT;
    DCL DONE INT;
    DCL IMAGE_BYTES INT;
    DCL DESC_PTR PTR;
    DCL STAT_NAME(17) CHAR;
    DCL ENDPOINT INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 116) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 97) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 116) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 32) THEN VALID = VALID; ELSE VALID = 0;
    POS = 0;
    DONE = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    DO WHILE (DONE = 0);
        IF (CH = 10) THEN DONE = 1;
        ELSE DO;
            IF (POS < 16) THEN DO; STAT_NAME(POS) = CH; POS = POS + 1; END;
            CALL TASK_GETCHAR(ADDR(CH));
        END;
    END;
    STAT_NAME(POS) = 0;
    ENDPOINT = 0;
    IF (POS = 1) THEN DO;
        IF (STAT_NAME(0) > 48) THEN DO;
            IF (STAT_NAME(0) < 52) THEN ENDPOINT = STAT_NAME(0) - 48;
        END;
    END;
    DESC_PTR = 0;
    IF (ENDPOINT > 0) THEN CALL SHELL_PROCESS_LINE(ENDPOINT);
    ELSE DO;
      IF (VALID = 1) THEN CALL TASK_CATALOG_STAT_FIND(ADDR(STAT_NAME), ADDR(DESC_PTR));
      IF (DESC_PTR = 0) THEN CALL SHELL_BAD;
      ELSE DO;
        CALL UART_PUTS(DESC_PTR->SPD_NAME);
        CALL UART_PUTS(ADDR(SHELL_STAT_KIND));
        IF (DESC_PTR->SPD_KIND = 2) THEN CALL UART_PUTS(ADDR(SHELL_SERVICE_TEXT));
        ELSE CALL UART_PUTS(ADDR(SHELL_PROGRAM_TEXT));
        CALL UART_PUTS(ADDR(SHELL_STAT_SOURCE));
        IF (DESC_PTR->SPD_KIND = 1) THEN CALL UART_PUTS(ADDR(SHELL_EMBEDDED_TEXT));
        ELSE CALL UART_PUTS(ADDR(SHELL_RESIDENT_TEXT));
        CALL UART_PUTS(ADDR(SHELL_STAT_STACK)); CALL SHELL_PRINT_INT(DESC_PTR->SPD_STACK_WORDS);
        CALL UART_PUTS(ADDR(SHELL_STAT_STATE)); CALL SHELL_PRINT_INT(DESC_PTR->SPD_STATE_WORDS);
        CALL UART_PUTS(ADDR(SHELL_STAT_FLAGS)); CALL SHELL_PRINT_INT(DESC_PTR->SPD_FLAGS);
        IMAGE_BYTES = DESC_PTR->SPD_IMAGE_WORDS;
        IMAGE_BYTES = IMAGE_BYTES * 3;
        CALL UART_PUTS(ADDR(SHELL_STAT_IMAGE)); CALL SHELL_PRINT_INT(IMAGE_BYTES);
        CALL UART_PUTCHAR(10);
      END;
    END;
END;

SHELL_PROCESS_LINE: PROC(ENDPOINT INT);
    CALL TASK_PROCESS_PRINT(ENDPOINT);
END;

