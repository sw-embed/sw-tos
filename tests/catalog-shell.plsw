/* catalog-shell.plsw -- persistent scheduled PL/SW menu bridge */

%DEFINE LIBRARY;

DCL 1 SHELL_PROCESS_STATE BASED,
    3 SPS_VALUE INT,
    3 SPS_COUNTER_DESC PTR,
    3 SPS_HELLO_DESC PTR,
    3 SPS_CLOCK_DESC PTR,
    3 SPS_EMBEDDED_DESC PTR,
    3 SPS_UPTIME_DESC PTR;
DCL 1 CLOCK_BYTE_REF BASED,
    3 CBR_VALUE BYTE;
DCL 1 SHELL_PROGRAM_DESC BASED,
    3 SPD_NAME PTR,
    3 SPD_KIND INT,
    3 SPD_SCHEDULED_ENTRY PTR,
    3 SPD_IMAGE PTR,
    3 SPD_IMAGE_WORDS INT,
    3 SPD_STACK_WORDS INT,
    3 SPD_STATE_WORDS INT,
    3 SPD_FLAGS INT;
DCL SHELL_HELP_1(39) CHAR INIT('help ls dir ps run bg sync kill reboot');
DCL SHELL_HELP_2(24) CHAR INIT('df du mem stat uname');
DCL SHELL_UNAME_TEXT(17) CHAR INIT('SWTOS COR24 0.1');
DCL SHELL_CPU_HOG_NAME(8) CHAR INIT('cpu-hog');
DCL SHELL_MON_NAME(4) CHAR INIT('mon');
DCL SHELL_SYNC_NOTE(30) CHAR INIT('no free slot: running it here');
DCL SHELL_FG_HINT(19) CHAR INIT('[Ctrl-[ to end]');
DCL SHELL_MEM_AT(2) CHAR INIT('@');
DCL SHELL_MEM_IMAGE(8) CHAR INIT(' image=');
DCL SHELL_MEM_NONE(9) CHAR INIT('resident');
DCL SHELL_KILL_NO_SUCH(17) CHAR INIT('no such endpoint');
DCL SHELL_KILL_GONE(23) CHAR INIT('nothing is running there');
DCL SHELL_KILL_USAGE(43) CHAR INIT('kill needs an endpoint, as in kill 3 or kill ep=3');
DCL SHELL_SYNC_NEEDS_SLOT(25) CHAR INIT('needs a slot of its own');
DCL SHELL_TOPIC_SYNC(38) CHAR INIT('sync NAME runs it here, without a slot');
DCL SHELL_STAT_KIND(7) CHAR INIT(' kind=');
DCL SHELL_STAT_SOURCE(9) CHAR INIT(' source=');
DCL SHELL_STAT_STACK(8) CHAR INIT(' stack=');
DCL SHELL_STAT_STATE(8) CHAR INIT(' state=');
DCL SHELL_STAT_FLAGS(8) CHAR INIT(' flags=');
DCL SHELL_STAT_IMAGE(8) CHAR INIT(' image=');
DCL SHELL_PROGRAM_TEXT(8) CHAR INIT('program');
DCL SHELL_SERVICE_TEXT(8) CHAR INIT('service');
DCL SHELL_RESIDENT_TEXT(9) CHAR INIT('resident');
DCL SHELL_EMBEDDED_TEXT(9) CHAR INIT('embedded');
DCL SHELL_MEM_TOTAL(8) CHAR INIT('total=');
DCL SHELL_MEM_IMAGE(8) CHAR INIT(' image=');
DCL SHELL_MEM_ARENA(8) CHAR INIT(' arena=');
DCL SHELL_MEM_PEAK(7) CHAR INIT(' peak=');
DCL SHELL_MEM_KSTACK(9) CHAR INIT(' kstack=');
DCL SHELL_MEM_FREE(7) CHAR INIT(' free=');
DCL SHELL_MEM_FAIL(11) CHAR INIT(' failures=');
DCL SHELL_MEM_SLOTS(8) CHAR INIT(' slots=');
DCL SHELL_MEM_RESET_TEXT(16) CHAR INIT('mem counters reset');
DCL SHELL_MEM_EP(5) CHAR INIT('ep=');
DCL SHELL_MEM_STATUS(9) CHAR INIT(' status=');
DCL SHELL_MEM_PROC_STACK(8) CHAR INIT(' stack=');
DCL SHELL_MEM_PROC_STATE(8) CHAR INIT(' state=');
DCL SHELL_MEM_PROC_TOTAL(8) CHAR INIT(' total=');
DCL SHELL_PROC_EP(4) CHAR INIT('ep=');
DCL SHELL_PROC_NAME(7) CHAR INIT(' name=');
DCL SHELL_PROC_STATUS(8) CHAR INIT(' state=');
DCL SHELL_PROC_BLOCKED(10) CHAR INIT(' blocked=');
DCL SHELL_PROC_STACK(8) CHAR INIT(' stack=');
DCL SHELL_PROC_STATE_WORDS(8) CHAR INIT(' statew=');
DCL SHELL_PROC_DISPATCH(11) CHAR INIT(' dispatch=');
DCL SHELL_PROC_YIELDS(8) CHAR INIT(' yields=');
DCL SHELL_PROC_IPC(6) CHAR INIT(' ipc=');
DCL SHELL_PROC_TTY_IN(9) CHAR INIT(' ttyin=');
DCL SHELL_PROC_TTY_OUT(10) CHAR INIT(' ttyout=');
DCL SHELL_PROC_NONE(5) CHAR INIT('none');
DCL SHELL_MON_STK(5) CHAR INIT('stk ');
DCL SHELL_MON_HEAP(8) CHAR INIT('B heap ');
DCL SHELL_MON_KSTK(8) CHAR INIT('B kstk=');
DCL SHELL_MON_FAIL(8) CHAR INIT('B fail=');
DCL SHELL_MON_EP(5) CHAR INIT(' ep=');
DCL SHELL_MON_STATE(4) CHAR INIT(' s=');
DCL SHELL_MON_BLOCKED(4) CHAR INIT(' b=');
