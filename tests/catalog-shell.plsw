/* catalog-shell.plsw -- persistent scheduled PL/SW menu bridge */

%DEFINE LIBRARY;

DCL 1 SHELL_PROCESS_STATE BASED,
    3 SPS_VALUE INT,
    3 SPS_COUNTER_DESC PTR,
    3 SPS_HELLO_DESC PTR,
    3 SPS_CLOCK_DESC PTR,
    3 SPS_EMBEDDED_DESC PTR;
DCL 1 CLOCK_BYTE_REF BASED,
    3 CBR_VALUE BYTE;

SHELL_MENU: PROC;
    CALL UART_PUTCHAR(77);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(78);
    CALL UART_PUTCHAR(85);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(49);
    CALL UART_PUTCHAR(61);
    CALL UART_PUTCHAR(72);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(50);
    CALL UART_PUTCHAR(61);
    CALL UART_PUTCHAR(67);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(117);
    CALL UART_PUTCHAR(110);
    CALL UART_PUTCHAR(116);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(114);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(51);
    CALL UART_PUTCHAR(61);
    CALL UART_PUTCHAR(67);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(99);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(48);
    CALL UART_PUTCHAR(61);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(120);
    CALL UART_PUTCHAR(105);
    CALL UART_PUTCHAR(116);
    CALL UART_PUTCHAR(10);
    CALL UART_PUTCHAR(67);
    CALL UART_PUTCHAR(104);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(105);
    CALL UART_PUTCHAR(99);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(58);
    CALL UART_PUTCHAR(32);
END;

SHELL_READY: PROC;
    CALL UART_PUTCHAR(82);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(65);
    CALL UART_PUTCHAR(68);
    CALL UART_PUTCHAR(89);
    CALL UART_PUTCHAR(10);
END;

SHELL_RUN_SELECTED: PROC(DESC_PTR PTR);
    DCL SPAWN_STATUS INT;
    CALL TASK_SPAWN(DESC_PTR);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN DO;
        CALL TASK_JOIN;
        CALL SHELL_READY;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_LIST_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 115) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 10) THEN VALID = VALID; ELSE VALID = 0;
    IF (VALID = 1) THEN DO;
        CALL TASK_CATALOG_LIST;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(66);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_PS_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 115) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 10) THEN VALID = VALID; ELSE VALID = 0;
    IF (VALID = 1) THEN CALL TASK_PROCESS_LIST;
    ELSE DO;
        CALL UART_PUTCHAR(66);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_RUN_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    DCL POS INT;
    DCL LINE_DONE INT;
    DCL DESC_PTR PTR;
    DCL RUN_NAME(17) CHAR;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 117) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 110) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 32) THEN VALID = VALID; ELSE VALID = 0;
    POS = 0;
    LINE_DONE = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    DO WHILE (LINE_DONE = 0);
        IF (CH = 10) THEN LINE_DONE = 1;
        ELSE DO;
            IF (CH = 13) THEN LINE_DONE = 1;
            ELSE DO;
                IF (POS < 16) THEN DO;
                    RUN_NAME(POS) = CH;
                    POS = POS + 1;
                END;
                CALL TASK_GETCHAR(ADDR(CH));
            END;
        END;
    END;
    RUN_NAME(POS) = 0;
    DESC_PTR = 0;
    IF (VALID = 1) THEN CALL TASK_CATALOG_FIND(ADDR(RUN_NAME), ADDR(DESC_PTR));
    IF (DESC_PTR = 0) THEN VALID = 0;
    IF (VALID = 1) THEN CALL SHELL_RUN_SELECTED(DESC_PTR);
    IF (VALID = 0) THEN DO;
        CALL UART_PUTCHAR(66);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
END;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL CH BYTE;
    DCL DONE INT;
    PRIVATE_STATE = STATE_PTR;
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL SHELL_MENU;
        CALL TASK_GETCHAR(ADDR(CH));
        IF (CH = 108) THEN CALL SHELL_LIST_COMMAND;
        ELSE DO;
        IF (CH = 112) THEN CALL SHELL_PS_COMMAND;
        ELSE DO;
        IF (CH = 114) THEN CALL SHELL_RUN_COMMAND;
        ELSE DO;
        IF (CH = 49) THEN DO;
            CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_HELLO_DESC);
        END;
        ELSE DO;
            IF (CH = 50) THEN DO;
                CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_COUNTER_DESC);
            END;
            ELSE DO;
                IF (CH = 51) THEN DO;
                    CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_CLOCK_DESC);
                END;
                ELSE DO;
                    IF (CH = 48) THEN DONE = 1;
                    ELSE DO;
                        CALL UART_PUTCHAR(66);
                        CALL UART_PUTCHAR(65);
                        CALL UART_PUTCHAR(68);
                        CALL UART_PUTCHAR(10);
                    END;
                END;
            END;
        END;
        END;
        END;
        END;
    END;
    CALL UART_PUTCHAR(66);
    CALL UART_PUTCHAR(89);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(10);
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->SPS_VALUE = PRIVATE_STATE->SPS_VALUE + 1;
        CALL TASK_STEP(PRIVATE_STATE->SPS_VALUE);
        IF (PRIVATE_STATE->SPS_VALUE = 2) THEN CALL TASK_EXIT;
    END;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    DCL CH BYTE;
    CALL UART_PUTCHAR(72);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(10);
    CALL UART_PUTCHAR(80);
    CALL UART_PUTCHAR(114);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(115);
    CALL UART_PUTCHAR(115);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(121);
    CALL UART_PUTCHAR(10);
    CALL TASK_GETCHAR(ADDR(CH));
    CALL TASK_EXIT;
END;

CLOCK_GET_PAYLOAD: PROC(OUT_PTR PTR);
    DCL CH BYTE;
    DCL CODE BYTE;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 255) THEN DO;
        CALL TASK_GETCHAR(ADDR(CODE));
        IF (CODE = 0) THEN OUT_PTR->CBR_VALUE = 255;
        ELSE DO;
            IF (CODE = 3) THEN OUT_PTR->CBR_VALUE = 29;
            ELSE OUT_PTR->CBR_VALUE = CODE;
        END;
    END;
    ELSE OUT_PTR->CBR_VALUE = CH;
END;

CLOCK_PRINT_2: PROC(N INT);
    DCL Q INT;
    Q = N / 10;
    CALL UART_PUTCHAR(Q + 48);
    CALL UART_PUTCHAR(N - Q * 10 + 48);
END;

CLOCK_PRINT_TIME: PROC(TOTAL_SECONDS INT);
    DCL MINUTES INT;
    DCL SECONDS INT;
    DCL HUNDREDS INT;
    MINUTES = TOTAL_SECONDS / 60;
    HUNDREDS = MINUTES / 100;
    MINUTES = MINUTES - HUNDREDS * 100;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL CLOCK_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL CLOCK_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    DCL CH BYTE;
    DCL CODE BYTE;
    DCL B0 BYTE;
    DCL B1 BYTE;
    DCL B2 BYTE;
    DCL TICK INT;
    DCL LAST_TICK INT;
    DCL TOTAL_TICKS INT;
    DCL CURRENT_SECOND INT;
    DCL LAST_SECOND INT;
    DCL SYNCED INT;
    DCL DONE INT;
    LAST_TICK = 0;
    TOTAL_TICKS = 0;
    LAST_SECOND = 0;
    SYNCED = 0;
    DONE = 0;
    CALL UART_PUTCHAR(67);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(99);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(10);
    CALL CLOCK_PRINT_TIME(0);
    DO WHILE (DONE = 0);
        CALL TASK_GETCHAR(ADDR(CH));
        IF (CH = 27) THEN DONE = 1;
        ELSE DO;
            IF (CH = 255) THEN DO;
                CALL TASK_GETCHAR(ADDR(CODE));
                IF (CODE = 1) THEN DO;
                    CALL CLOCK_GET_PAYLOAD(ADDR(B0));
                    CALL CLOCK_GET_PAYLOAD(ADDR(B1));
                    CALL CLOCK_GET_PAYLOAD(ADDR(B2));
                    TICK = B0 + B1 * 256 + B2 * 65536;
                    IF (SYNCED = 0) THEN DO;
                        LAST_TICK = TICK;
                        SYNCED = 1;
                    END;
                    ELSE DO;
                        TOTAL_TICKS = TOTAL_TICKS + TICK - LAST_TICK;
                        LAST_TICK = TICK;
                        CURRENT_SECOND = TOTAL_TICKS / 100;
                        IF (CURRENT_SECOND > LAST_SECOND) THEN DO;
                            LAST_SECOND = CURRENT_SECOND;
                            CALL CLOCK_PRINT_TIME(CURRENT_SECOND);
                        END;
                    END;
                END;
            END;
        END;
    END;
    CALL TASK_EXIT;
END;
