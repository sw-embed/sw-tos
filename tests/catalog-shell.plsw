SHELL_UART_TEST: PROC;
    DCL CH INT;
    DO WHILE (1);
        DO CH = 65 TO 90;
            CALL UART_PUTCHAR(CH);
        END;
        DO CH = 48 TO 57;
            CALL UART_PUTCHAR(CH);
        END;
    END;
END;

SHELL_FILL_DEMO: PROC(STATE_PTR PTR);
    /* Spawn children until the process table refuses another, so the demo
       does not hard-code the slot count. Uptime and Clock alternate because
       both keep printing, which makes every pane visibly live; neither joins,
       so the shell stays usable while they run.

       Two cpu-hogs go in first, but only when a framed frontend is attached.
       They never yield, so the clocks that follow keep printing only if
       forced preemption is working, and forced preemption needs the heartbeat
       that only such a frontend sends. Under a bare UART the same two
       processes would take the CPU and never give it back, so there the table
       fills with clocks alone. The hogs are found by catalog name rather than
       held in the shell's private state, which keeps the spawn state the boot
       code fills unchanged. */
    DCL PRIVATE_STATE PTR;
    DCL SPAWN_STATUS INT;
    DCL WHICH INT;
    DCL HOG_DESC PTR;
    DCL FRAMED INT;
    PRIVATE_STATE = STATE_PTR;
    HOG_DESC = 0;
    FRAMED = 0;
    CALL TASK_FRONTEND_ATTACHED(ADDR(FRAMED));
    IF (FRAMED = 0) THEN HOG_DESC = 0;
    ELSE CALL TASK_CATALOG_FIND(ADDR(SHELL_CPU_HOG_NAME), ADDR(HOG_DESC));
    IF (HOG_DESC = 0) THEN HOG_DESC = 0;
    ELSE DO;
        SPAWN_STATUS = 0;
        CALL TASK_SPAWN(HOG_DESC);
        CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
        IF (SPAWN_STATUS = 0) THEN DO;
            CALL TASK_SPAWN(HOG_DESC);
            CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
        END;
    END;
    SPAWN_STATUS = 0;
    WHICH = 0;
    DO WHILE (SPAWN_STATUS = 0);
        IF (WHICH = 0) THEN DO;
            CALL TASK_SPAWN(PRIVATE_STATE->SPS_UPTIME_DESC);
            WHICH = 1;
        END;
        ELSE DO;
            CALL TASK_SPAWN(PRIVATE_STATE->SPS_CLOCK_DESC);
            WHICH = 0;
        END;
        CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    END;
    /* TASK_PROCESS_LIST, not SHELL_PS_COMMAND: the latter parses the typed
       line and would block here waiting for characters nobody will send. */
    CALL TASK_PROCESS_LIST;
    CALL SHELL_READY;
END;

SHELL_MULTITASK_DEMO: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL FIRST_STATUS INT;
    DCL SECOND_STATUS INT;
    PRIVATE_STATE = STATE_PTR;
    CALL TASK_SPAWN(PRIVATE_STATE->SPS_COUNTER_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(FIRST_STATUS));
    CALL TASK_SPAWN(PRIVATE_STATE->SPS_COUNTER_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(SECOND_STATUS));
    IF (FIRST_STATUS = 0) THEN DO;
        IF (SECOND_STATUS = 0) THEN DO;
            CALL TASK_JOIN;
            CALL SHELL_READY;
        END;
        ELSE CALL SHELL_READY;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_READY: PROC;
    CALL UART_PUTCHAR(82);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(65);
    CALL UART_PUTCHAR(68);
    CALL UART_PUTCHAR(89);
    CALL UART_PUTCHAR(10);
END;

SHELL_RUN_SELECTED: PROC(DESC_PTR PTR);
    DCL SPAWN_STATUS INT;
    CALL TASK_SPAWN(DESC_PTR);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN DO;
        CALL TASK_JOIN;
        CALL SHELL_READY;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_RUN_SELECTED_NEW_TTY: PROC(DESC_PTR PTR);
    DCL SPAWN_STATUS INT;
    CALL TASK_SPAWN(DESC_PTR);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN CALL SHELL_READY;
    ELSE DO;
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_LIST_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 115) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 10) THEN VALID = VALID; ELSE VALID = 0;
    IF (VALID = 1) THEN DO;
        CALL TASK_CATALOG_LIST;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(66);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
END;

SHELL_PS_COMMAND: PROC;
    DCL CH BYTE;
    DCL NEXT BYTE;
    DCL VALID INT;
    DCL EP INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 115) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 10) THEN CALL TASK_PROCESS_LIST;
    ELSE DO;
        IF (CH = 32) THEN DO;
            CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 45) THEN VALID = VALID; ELSE VALID = 0;
            CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 108) THEN VALID = VALID; ELSE VALID = 0;
            CALL TASK_GETCHAR(ADDR(NEXT)); IF (NEXT = 10) THEN VALID = VALID; ELSE VALID = 0;
            IF (VALID = 1) THEN DO;
                EP = 1;
                DO WHILE (EP < 17);
                    CALL SHELL_PROCESS_LINE(EP);
                    EP = EP + 1;
                END;
            END;
            ELSE CALL SHELL_BAD;
        END;
        ELSE CALL SHELL_BAD;
    END;
END;

SHELL_RUN_COMMAND: PROC;
    DCL CH BYTE;
    DCL VALID INT;
    DCL POS INT;
    DCL LINE_DONE INT;
    DCL DESC_PTR PTR;
    DCL RUN_NAME(17) CHAR;
    DCL NEW_TTY INT;
    VALID = 1;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 117) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 110) THEN VALID = VALID; ELSE VALID = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 32) THEN VALID = VALID; ELSE VALID = 0;
    POS = 0;
    NEW_TTY = 0;
    LINE_DONE = 0;
    CALL TASK_GETCHAR(ADDR(CH));
    DO WHILE (LINE_DONE = 0);
        IF (CH = 10) THEN LINE_DONE = 1;
        ELSE DO;
            IF (CH = 13) THEN LINE_DONE = 1;
            ELSE DO;
                IF (CH = 32) THEN DO;
                    NEW_TTY = 1;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 45) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 45) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 116) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 116) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 121) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 61) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 110) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 101) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 119) THEN VALID = VALID; ELSE VALID = 0;
                    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 10) THEN LINE_DONE = 1; ELSE DO;
                        IF (CH = 13) THEN LINE_DONE = 1; ELSE VALID = 0;
                    END;
                END;
                ELSE DO;
                    IF (POS < 16) THEN DO;
                        RUN_NAME(POS) = CH;
                        POS = POS + 1;
                    END;
                    CALL TASK_GETCHAR(ADDR(CH));
                END;
            END;
        END;
    END;
    RUN_NAME(POS) = 0;
    DESC_PTR = 0;
    IF (VALID = 1) THEN CALL TASK_CATALOG_FIND(ADDR(RUN_NAME), ADDR(DESC_PTR));
    IF (DESC_PTR = 0) THEN VALID = 0;
    IF (VALID = 1) THEN DO;
        IF (NEW_TTY = 1) THEN CALL SHELL_RUN_SELECTED_NEW_TTY(DESC_PTR);
        ELSE CALL SHELL_RUN_SELECTED(DESC_PTR);
    END;
    IF (VALID = 0) THEN DO;
        CALL UART_PUTCHAR(66);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
END;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL CH BYTE;
    DCL DONE INT;
    PRIVATE_STATE = STATE_PTR;
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL SHELL_MENU;
        CALL TASK_GETCHAR(ADDR(CH));
        IF (CH = 104) THEN CALL SHELL_HELP_COMMAND;
        ELSE DO;
        IF (CH = 100) THEN CALL SHELL_D_COMMAND;
        ELSE DO;
        IF (CH = 117) THEN CALL SHELL_UNAME_COMMAND;
        ELSE DO;
        IF (CH = 115) THEN CALL SHELL_STAT_COMMAND;
        ELSE DO;
        IF (CH = 108) THEN CALL SHELL_LIST_COMMAND;
        ELSE DO;
        IF (CH = 109) THEN CALL SHELL_MEM_COMMAND;
        ELSE DO;
        IF (CH = 112) THEN CALL SHELL_PS_COMMAND;
        ELSE DO;
        IF (CH = 114) THEN CALL SHELL_RUN_COMMAND;
        ELSE DO;
        IF (CH = 49) THEN DO;
            CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_HELLO_DESC);
        END;
        ELSE DO;
            IF (CH = 50) THEN DO;
                CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_COUNTER_DESC);
            END;
            ELSE DO;
                IF (CH = 51) THEN DO;
                    CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_UPTIME_DESC);
                END;
                ELSE DO;
                IF (CH = 52) THEN DO;
                    CALL SHELL_RUN_SELECTED(PRIVATE_STATE->SPS_CLOCK_DESC);
                END;
                ELSE DO;
                    IF (CH = 53) THEN DO;
                        CALL SHELL_MULTITASK_DEMO(PRIVATE_STATE);
                    END;
                    ELSE DO;
                        IF (CH = 54) THEN CALL SHELL_UART_TEST;
                        ELSE DO;
                        IF (CH = 57) THEN CALL SHELL_FILL_DEMO(PRIVATE_STATE);
                        ELSE DO;
                            CALL UART_PUTCHAR(66);
                            CALL UART_PUTCHAR(65);
                            CALL UART_PUTCHAR(68);
                            CALL UART_PUTCHAR(10);
                        END;
                        END;
                    END;
                END;
                END;
            END;
        END;
        END;
        END;
        END;
        END;
        END;
        END;
        END;
        END;
    END;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->SPS_VALUE = PRIVATE_STATE->SPS_VALUE + 1;
        CALL TASK_STEP(PRIVATE_STATE->SPS_VALUE);
        IF (PRIVATE_STATE->SPS_VALUE = 2) THEN CALL TASK_EXIT;
    END;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    DCL CH BYTE;
    CALL UART_PUTCHAR(72);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(10);
    CALL UART_PUTCHAR(80);
    CALL UART_PUTCHAR(114);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(115);
    CALL UART_PUTCHAR(115);
    CALL UART_PUTCHAR(32);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(121);
    CALL UART_PUTCHAR(10);
    CALL TASK_GETCHAR(ADDR(CH));
    CALL TASK_EXIT;
END;

TIME_GET_PAYLOAD: PROC(OUT_PTR PTR);
    DCL CH BYTE;
    DCL CODE BYTE;
    CALL TASK_GETCHAR(ADDR(CH));
    IF (CH = 255) THEN DO;
        CALL TASK_GETCHAR(ADDR(CODE));
        IF (CODE = 0) THEN OUT_PTR->CBR_VALUE = 255;
        ELSE DO;
            IF (CODE = 3) THEN OUT_PTR->CBR_VALUE = 29;
            ELSE OUT_PTR->CBR_VALUE = CODE;
        END;
    END;
    ELSE OUT_PTR->CBR_VALUE = CH;
END;

TIME_PRINT_2: PROC(N INT);
    DCL Q INT;
    Q = N / 10;
    CALL UART_PUTCHAR(Q + 48);
    CALL UART_PUTCHAR(N - Q * 10 + 48);
END;

UPTIME_PRINT: PROC(TOTAL_SECONDS INT);
    DCL MINUTES INT;
    DCL SECONDS INT;
    DCL HUNDREDS INT;
    MINUTES = TOTAL_SECONDS / 60;
    HUNDREDS = MINUTES / 100;
    MINUTES = MINUTES - HUNDREDS * 100;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL TIME_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

CLOCK_PRINT: PROC(TOTAL_SECONDS INT);
    DCL HOURS INT;
    DCL MINUTES INT;
    DCL SECONDS INT;
    HOURS = TOTAL_SECONDS / 3600;
    MINUTES = (TOTAL_SECONDS - HOURS * 3600) / 60;
    SECONDS = TOTAL_SECONDS - (TOTAL_SECONDS / 60) * 60;
    CALL TIME_PRINT_2(HOURS);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(MINUTES);
    CALL UART_PUTCHAR(58);
    CALL TIME_PRINT_2(SECONDS);
    CALL UART_PUTCHAR(10);
END;

PLSW_TIME_APP: PROC(STATE_PTR PTR, FRAME_CODE INT);
    DCL CH BYTE;
    DCL CODE BYTE;
    DCL B0 BYTE;
    DCL B1 BYTE;
    DCL B2 BYTE;
    DCL TICK INT;
    DCL CURRENT_SECOND INT;
    DCL LAST_SECOND INT;
    DCL SYNCED INT;
    DCL DONE INT;
    LAST_SECOND = 0;
    SYNCED = 0;
    DONE = 0;
    DO WHILE (DONE = 0);
        CALL TASK_GETCHAR(ADDR(CH));
        IF (CH = 27) THEN DONE = 1;
        ELSE DO;
            IF (CH = 255) THEN DO;
                CALL TASK_GETCHAR(ADDR(CODE));
                IF (CODE = FRAME_CODE) THEN DO;
                    CALL TIME_GET_PAYLOAD(ADDR(B0));
                    CALL TIME_GET_PAYLOAD(ADDR(B1));
                    CALL TIME_GET_PAYLOAD(ADDR(B2));
                    TICK = B0 + B1 * 256 + B2 * 65536;
                    IF (SYNCED = 0) THEN DO;
                        CURRENT_SECOND = TICK / 100;
                        LAST_SECOND = CURRENT_SECOND;
                        SYNCED = 1;
                        IF (FRAME_CODE = 1) THEN CALL UPTIME_PRINT(CURRENT_SECOND);
                        ELSE CALL CLOCK_PRINT(CURRENT_SECOND);
                    END;
                    ELSE DO;
                        CURRENT_SECOND = TICK / 100;
                        IF (CURRENT_SECOND = LAST_SECOND) THEN LAST_SECOND = LAST_SECOND;
                        ELSE DO;
                            LAST_SECOND = CURRENT_SECOND;
                            IF (FRAME_CODE = 1) THEN CALL UPTIME_PRINT(CURRENT_SECOND);
                            ELSE CALL CLOCK_PRINT(CURRENT_SECOND);
                        END;
                    END;
                END;
            END;
        END;
    END;
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL UART_PUTCHAR(85);
    CALL UART_PUTCHAR(112);
    CALL UART_PUTCHAR(116);
    CALL UART_PUTCHAR(105);
    CALL UART_PUTCHAR(109);
    CALL UART_PUTCHAR(101);
    CALL UART_PUTCHAR(10);
    CALL PLSW_TIME_APP(STATE_PTR, 1);
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL UART_PUTCHAR(67);
    CALL UART_PUTCHAR(108);
    CALL UART_PUTCHAR(111);
    CALL UART_PUTCHAR(99);
    CALL UART_PUTCHAR(107);
    CALL UART_PUTCHAR(10);
    CALL PLSW_TIME_APP(STATE_PTR, 2);
END;
