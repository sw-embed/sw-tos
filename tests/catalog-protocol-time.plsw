/* catalog-protocol-time.plsw -- typed clock frame routing proof */

%DEFINE LIBRARY;

DCL 1 PROTOCOL_TIME_STATE BASED,
    3 PTS_VALUE INT,
    3 PTS_COUNTER_DESC PTR,
    3 PTS_HELLO_DESC PTR,
    3 PTS_CLOCK_DESC PTR,
    3 PTS_EMBEDDED_HELLO_DESC PTR,
    3 PTS_UPTIME_DESC PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL STATUS INT;
    PRIVATE_STATE = STATE_PTR;
    CALL TASK_SPAWN(PRIVATE_STATE->PTS_UPTIME_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(STATUS));
    IF (STATUS = 0) THEN CALL TASK_JOIN; ELSE CALL TASK_HALT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    DCL CH BYTE;
    CALL UART_PUTCHAR(82);
    CALL UART_PUTCHAR(10);
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 255) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 1) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 255) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 0) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 255) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 3) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL TASK_GETCHAR(ADDR(CH)); IF (CH = 1) THEN CH = CH; ELSE CALL TASK_HALT;
    CALL UART_PUTCHAR(84);
    CALL UART_PUTCHAR(73);
    CALL UART_PUTCHAR(77);
    CALL UART_PUTCHAR(69);
    CALL TASK_EXIT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR); CALL TASK_EXIT; END;
PLSW_HELLO: PROC(STATE_PTR PTR); CALL TASK_EXIT; END;
PLSW_CLOCK: PROC(STATE_PTR PTR); CALL TASK_EXIT; END;
