/* catalog-spi.plsw -- W25Q32 catalog lookup and executable load proof */

%DEFINE LIBRARY;

DCL 1 SPI_STATE BASED,
    3 SS_VALUE INT,
    3 SS_COUNTER_DESC PTR,
    3 SS_HELLO_DESC PTR,
    3 SS_CLOCK_DESC PTR,
    3 SS_EMBEDDED_DESC PTR;
DCL 1 TEST_PROGRAM_DESC BASED,
    3 TPD_NAME PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL EMBEDDED_DESC PTR;
    DCL FOUND PTR;
    DCL SPAWN_STATUS INT;
    PRIVATE_STATE = STATE_PTR;
    EMBEDDED_DESC = PRIVATE_STATE->SS_EMBEDDED_DESC;
    FOUND = 0;
    CALL TASK_USE_SPI_PROVIDER;
    CALL TASK_CATALOG_FIND(EMBEDDED_DESC->TPD_NAME, ADDR(FOUND));
    IF (FOUND = 0) THEN CALL TASK_HALT;
    CALL TASK_SPAWN(FOUND);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN CALL TASK_JOIN;
    ELSE DO;
        CALL UART_PUTCHAR(67);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(67);
        CALL UART_PUTCHAR(70);
        CALL UART_PUTCHAR(65);
        CALL UART_PUTCHAR(73);
        CALL UART_PUTCHAR(76);
        CALL UART_PUTCHAR(10);
        CALL TASK_HALT;
    END;
    CALL TASK_SPI_PROVIDER_VERIFY;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
