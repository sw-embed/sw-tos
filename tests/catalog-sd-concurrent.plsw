/* Concurrent SD descriptor ownership and execution proof. */

%DEFINE LIBRARY;

DCL 1 SD_STATE BASED,
    3 SS_VALUE INT,
    3 SS_COUNTER_DESC PTR,
    3 SS_HELLO_DESC PTR,
    3 SS_CLOCK_DESC PTR,
    3 SS_EMBEDDED_DESC PTR;
DCL 1 TEST_PROGRAM_DESC BASED,
    3 TPD_NAME PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL EMBEDDED_DESC PTR;
    DCL HELLO_DESC PTR;
    DCL PING_DESC PTR;
    DCL SPAWN_STATUS INT;
    DCL PING_NAME(14) CHAR;
    PRIVATE_STATE = STATE_PTR;
    EMBEDDED_DESC = PRIVATE_STATE->SS_EMBEDDED_DESC;
    PING_NAME(0) = 101;
    PING_NAME(1) = 109;
    PING_NAME(2) = 98;
    PING_NAME(3) = 101;
    PING_NAME(4) = 100;
    PING_NAME(5) = 100;
    PING_NAME(6) = 101;
    PING_NAME(7) = 100;
    PING_NAME(8) = 45;
    PING_NAME(9) = 112;
    PING_NAME(10) = 105;
    PING_NAME(11) = 110;
    PING_NAME(12) = 103;
    PING_NAME(13) = 0;
    HELLO_DESC = 0;
    PING_DESC = 0;
    CALL TASK_USE_SD_PROVIDER;
    CALL TASK_CATALOG_FIND(EMBEDDED_DESC->TPD_NAME, ADDR(HELLO_DESC));
    IF (HELLO_DESC = 0) THEN CALL TASK_HALT;
    CALL TASK_SPAWN(HELLO_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN SPAWN_STATUS = SPAWN_STATUS;
    ELSE CALL TASK_HALT;
    CALL TASK_CATALOG_FIND(ADDR(PING_NAME), ADDR(PING_DESC));
    IF (PING_DESC = 0) THEN CALL TASK_HALT;
    CALL TASK_SPAWN(PING_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN SPAWN_STATUS = SPAWN_STATUS;
    ELSE CALL TASK_HALT;
    CALL TASK_DESCRIPTOR_SNAPSHOT_VERIFY;
    CALL TASK_JOIN;
    CALL TASK_RECOVERY_RECLAIM_VERIFY;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
