/* catalog-counter.plsw -- scheduled PL/SW resident task */

%DEFINE LIBRARY;

DCL 1 COUNTER_PROCESS_STATE BASED,
    3 CPS_VALUE INT,
    3 CPS_SPAWN_DESC PTR;

COUNTER_RUN: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->CPS_VALUE = PRIVATE_STATE->CPS_VALUE + 1;
        IF (PRIVATE_STATE->CPS_VALUE = 1) THEN DO;
            CALL TASK_SPAWN(PRIVATE_STATE->CPS_SPAWN_DESC);
        END;
        CALL TASK_STEP(PRIVATE_STATE->CPS_VALUE);
    END;
END;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    CALL COUNTER_RUN(STATE_PTR);
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    CALL COUNTER_RUN(STATE_PTR);
END;
