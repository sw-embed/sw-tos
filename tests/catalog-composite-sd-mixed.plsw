/* Concurrent resident and SD-backed composite-provider proof. */

%DEFINE LIBRARY;

DCL 1 MIXED_STATE BASED,
    3 MS_VALUE INT,
    3 MS_COUNTER_DESC PTR,
    3 MS_HELLO_DESC PTR,
    3 MS_CLOCK_DESC PTR,
    3 MS_EMBEDDED_DESC PTR;
DCL 1 TEST_PROGRAM_DESC BASED,
    3 TPD_NAME PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL EMBEDDED_DESC PTR;
    DCL FOUND PTR;
    DCL SPAWN_STATUS INT;
    PRIVATE_STATE = STATE_PTR;
    EMBEDDED_DESC = PRIVATE_STATE->MS_EMBEDDED_DESC;
    CALL TASK_SPAWN(PRIVATE_STATE->MS_COUNTER_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN SPAWN_STATUS = SPAWN_STATUS;
    ELSE CALL TASK_HALT;
    FOUND = 0;
    CALL TASK_CATALOG_FIND(EMBEDDED_DESC->TPD_NAME, ADDR(FOUND));
    IF (FOUND = 0) THEN CALL TASK_HALT;
    CALL TASK_SPAWN(FOUND);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN SPAWN_STATUS = SPAWN_STATUS;
    ELSE CALL TASK_HALT;
    CALL TASK_MIXED_DESCRIPTOR_VERIFY;
    CALL TASK_JOIN;
    CALL TASK_RECOVERY_RECLAIM_VERIFY;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->MS_VALUE = PRIVATE_STATE->MS_VALUE + 1;
        CALL TASK_STEP(PRIVATE_STATE->MS_VALUE);
        IF (PRIVATE_STATE->MS_VALUE = 2) THEN CALL TASK_EXIT;
    END;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
