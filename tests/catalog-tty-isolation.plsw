/* catalog-tty-isolation.plsw -- two independently blocked virtual-TTY readers */

%DEFINE LIBRARY;

DCL 1 TTY_TEST_STATE BASED,
    3 TTS_VALUE INT,
    3 TTS_COUNTER_DESC PTR,
    3 TTS_HELLO_DESC PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL STATUS INT;
    PRIVATE_STATE = STATE_PTR;
    CALL TASK_SPAWN(PRIVATE_STATE->TTS_HELLO_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(STATUS));
    IF (STATUS = 0) THEN STATUS = STATUS; ELSE CALL TASK_HALT;
    CALL TASK_SPAWN(PRIVATE_STATE->TTS_HELLO_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(STATUS));
    IF (STATUS = 0) THEN CALL TASK_JOIN; ELSE CALL TASK_HALT;
    CALL UART_PUTCHAR(10);
    CALL TASK_HALT;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    DCL CH BYTE;
    CALL TASK_GETCHAR(ADDR(CH));
    CALL UART_PUTCHAR(CH);
    CALL TASK_EXIT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR); CALL TASK_EXIT; END;
PLSW_MON: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR); CALL TASK_EXIT; END;
PLSW_CLOCK: PROC(STATE_PTR PTR); CALL TASK_EXIT; END;
