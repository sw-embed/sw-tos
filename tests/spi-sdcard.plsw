/* PL/SW client of the SWTOS SPI SD-card sector service. */

%DEFINE LIBRARY;

PRINT_HEX_NIBBLE: PROC(VALUE INT);
    IF (VALUE < 10) THEN CALL UART_PUTCHAR(VALUE + 48);
    ELSE CALL UART_PUTCHAR(VALUE + 55);
END;

PRINT_HEX_BYTE: PROC(VALUE BYTE);
    DCL HIGH INT;
    HIGH = VALUE / 16;
    CALL PRINT_HEX_NIBBLE(HIGH);
    CALL PRINT_HEX_NIBBLE(VALUE - HIGH * 16);
END;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL SECTOR(512) CHAR;
    DCL STATUS INT;
    DCL POS INT;
    CALL SPI_SD_READ_SECTOR(1, ADDR(SECTOR), ADDR(STATUS));
    IF (STATUS = 0) THEN DO;
        POS = 0;
        DO WHILE (POS < 16);
            CALL PRINT_HEX_BYTE(SECTOR(POS));
            IF (POS < 15) THEN CALL UART_PUTCHAR(32);
            ELSE CALL UART_PUTCHAR(10);
            POS = POS + 1;
        END;
        IF (SECTOR(511) = 0) THEN DO;
            CALL UART_PUTCHAR(69);
            CALL UART_PUTCHAR(78);
            CALL UART_PUTCHAR(68);
            CALL UART_PUTCHAR(10);
        END;
        ELSE CALL TASK_HALT;
    END;
    ELSE DO;
        CALL UART_PUTCHAR(83);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(32);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_MON: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
