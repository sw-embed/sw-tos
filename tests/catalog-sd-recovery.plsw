/* Recover from one corrupt SD image and execute the next catalog image. */

%DEFINE LIBRARY;

DCL 1 SD_STATE BASED,
    3 SS_VALUE INT,
    3 SS_COUNTER_DESC PTR,
    3 SS_HELLO_DESC PTR,
    3 SS_CLOCK_DESC PTR,
    3 SS_EMBEDDED_DESC PTR;
DCL 1 TEST_PROGRAM_DESC BASED,
    3 TPD_NAME PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL EMBEDDED_DESC PTR;
    DCL FIRST_DESC PTR;
    DCL PING_DESC PTR;
    DCL SPAWN_STATUS INT;
    DCL ITERATION INT;
    DCL PING_NAME(14) CHAR;
    PRIVATE_STATE = STATE_PTR;
    EMBEDDED_DESC = PRIVATE_STATE->SS_EMBEDDED_DESC;
    PING_NAME(0) = 101;
    PING_NAME(1) = 109;
    PING_NAME(2) = 98;
    PING_NAME(3) = 101;
    PING_NAME(4) = 100;
    PING_NAME(5) = 100;
    PING_NAME(6) = 101;
    PING_NAME(7) = 100;
    PING_NAME(8) = 45;
    PING_NAME(9) = 112;
    PING_NAME(10) = 105;
    PING_NAME(11) = 110;
    PING_NAME(12) = 103;
    PING_NAME(13) = 0;
    ITERATION = 0;
    CALL TASK_USE_SD_PROVIDER;
    DO WHILE (ITERATION < 20);
        FIRST_DESC = 0;
        PING_DESC = 0;
        CALL TASK_CATALOG_FIND(EMBEDDED_DESC->TPD_NAME, ADDR(FIRST_DESC));
        IF (FIRST_DESC = 0) THEN CALL TASK_HALT;
        CALL TASK_SPAWN(FIRST_DESC);
        CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
        IF (SPAWN_STATUS = 1) THEN CALL UART_PUTCHAR(70);
        ELSE CALL TASK_HALT;
        CALL TASK_CATALOG_FIND(ADDR(PING_NAME), ADDR(PING_DESC));
        IF (PING_DESC = 0) THEN CALL TASK_HALT;
        CALL TASK_SPAWN(PING_DESC);
        CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
        IF (SPAWN_STATUS = 0) THEN CALL TASK_JOIN;
        ELSE CALL TASK_HALT;
        ITERATION = ITERATION + 1;
    END;
    CALL TASK_RECOVERY_RECLAIM_VERIFY;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
