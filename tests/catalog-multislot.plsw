/* catalog-multislot.plsw -- concurrent child process-table proof */

%DEFINE LIBRARY;

DCL 1 MULTI_STATE BASED,
    3 MS_VALUE INT,
    3 MS_COUNTER_DESC PTR,
    3 MS_HELLO_DESC PTR,
    3 MS_CLOCK_DESC PTR,
    3 MS_EMBEDDED_DESC PTR;
DCL 1 TEST_PROGRAM_DESC BASED,
    3 TPD_NAME PTR;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    DCL SPAWN_STATUS INT;
    DCL BLOCK_FOUND PTR;
    DCL BLOCK_DESCRIPTOR PTR;
    PRIVATE_STATE = STATE_PTR;
    CALL TASK_PROVIDER_FAIL_NEXT;
    CALL TASK_SPAWN(PRIVATE_STATE->MS_EMBEDDED_DESC);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 1) THEN DO;
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(67);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(86);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(68);
        CALL UART_PUTCHAR(10);
    END;
    ELSE CALL TASK_HALT;
    CALL TASK_PROVIDER_BOUNDS_TEST;
    CALL TASK_USE_BLOCK_PROVIDER;
    BLOCK_FOUND = 0;
    BLOCK_DESCRIPTOR = PRIVATE_STATE->MS_EMBEDDED_DESC;
    CALL TASK_CATALOG_FIND(BLOCK_DESCRIPTOR->TPD_NAME, ADDR(BLOCK_FOUND));
    IF (BLOCK_FOUND = 0) THEN CALL TASK_HALT;
    CALL TASK_SPAWN(BLOCK_FOUND);
    CALL TASK_SPAWN_RESULT(ADDR(SPAWN_STATUS));
    IF (SPAWN_STATUS = 0) THEN CALL TASK_JOIN;
    ELSE CALL TASK_HALT;
    CALL TASK_BLOCK_PROVIDER_VERIFY;
    CALL TASK_SPAWN(PRIVATE_STATE->MS_COUNTER_DESC);
    CALL TASK_SPAWN(PRIVATE_STATE->MS_COUNTER_DESC);
    CALL TASK_PROCESS_LIST;
    CALL TASK_JOIN;
    CALL UART_PUTCHAR(68);
    CALL UART_PUTCHAR(79);
    CALL UART_PUTCHAR(78);
    CALL UART_PUTCHAR(69);
    CALL UART_PUTCHAR(10);
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    DCL PRIVATE_STATE PTR;
    PRIVATE_STATE = STATE_PTR;
    DO WHILE (1);
        PRIVATE_STATE->MS_VALUE = PRIVATE_STATE->MS_VALUE + 1;
        CALL TASK_STEP(PRIVATE_STATE->MS_VALUE);
        IF (PRIVATE_STATE->MS_VALUE = 2) THEN CALL TASK_EXIT;
    END;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_MON: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
