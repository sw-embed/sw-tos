/* PL/SW client of the SWTOS DS1307 I2C service. */

%DEFINE LIBRARY;

PRINT_BCD: PROC(VALUE BYTE);
    DCL HIGH INT;
    HIGH = VALUE / 16;
    CALL UART_PUTCHAR(HIGH + 48);
    CALL UART_PUTCHAR(VALUE - HIGH * 16 + 48);
END;

PLSW_LAUNCHER: PROC(STATE_PTR PTR);
    DCL RTC_BYTES(3) CHAR;
    DCL STATUS INT;
    DCL OLED_STATUS INT;
    CALL I2C_DS1307_READ(ADDR(RTC_BYTES), ADDR(STATUS));
    IF (STATUS = 0) THEN DO;
        CALL I2C_SSD1306_SHOW_TIME(ADDR(RTC_BYTES), ADDR(OLED_STATUS));
        IF (OLED_STATUS = 0) THEN DO;
            CALL UART_PUTCHAR(79);
            CALL UART_PUTCHAR(76);
            CALL UART_PUTCHAR(69);
            CALL UART_PUTCHAR(68);
            CALL UART_PUTCHAR(32);
        END;
        ELSE DO;
            CALL UART_PUTCHAR(79);
            CALL UART_PUTCHAR(76);
            CALL UART_PUTCHAR(69);
            CALL UART_PUTCHAR(68);
            CALL UART_PUTCHAR(32);
            CALL UART_PUTCHAR(69);
            CALL UART_PUTCHAR(82);
            CALL UART_PUTCHAR(82);
            CALL UART_PUTCHAR(79);
            CALL UART_PUTCHAR(82);
            CALL UART_PUTCHAR(10);
            CALL TASK_HALT;
        END;
        CALL PRINT_BCD(RTC_BYTES(2));
        CALL UART_PUTCHAR(58);
        CALL PRINT_BCD(RTC_BYTES(1));
        CALL UART_PUTCHAR(58);
        CALL PRINT_BCD(RTC_BYTES(0));
        CALL UART_PUTCHAR(10);
    END;
    ELSE DO;
        CALL UART_PUTCHAR(73);
        CALL UART_PUTCHAR(50);
        CALL UART_PUTCHAR(67);
        CALL UART_PUTCHAR(32);
        CALL UART_PUTCHAR(69);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(79);
        CALL UART_PUTCHAR(82);
        CALL UART_PUTCHAR(10);
    END;
    CALL TASK_HALT;
END;

PLSW_COUNTER: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_HELLO: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_UPTIME: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;

PLSW_CLOCK: PROC(STATE_PTR PTR);
    CALL TASK_EXIT;
END;
